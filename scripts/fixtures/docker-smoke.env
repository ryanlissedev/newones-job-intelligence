# Synthetic values used only by the disposable application-image CI smoke.
POSTGRES_ADMIN_USER=ji_admin
POSTGRES_ADMIN_PASSWORD=ji_admin_smoke
POSTGRES_DB=ji_smoke
POSTGRES_MIGRATOR_USER=ji_migrator
POSTGRES_MIGRATOR_PASSWORD=ji_migrator_smoke
POSTGRES_APP_USER=ji_app
POSTGRES_APP_PASSWORD=ji_app_smoke
CATAPULZE_DATABASE_URL=postgresql://ji_app:ji_app_smoke@postgres:5432/ji_smoke
PROJECTOR_DATABASE_URL=postgresql://ji_app:ji_app_smoke@postgres:5432/ji_smoke
BETTER_AUTH_SECRET=synthetic-ci-only-secret-at-least-32-characters
BETTER_AUTH_URL=http://server:3000
CORS_ORIGIN=http://web:3001
NEXT_PUBLIC_SERVER_URL=http://server:3000
INTERNAL_SERVER_URL=http://server:3000
APP_RELEASE_SHA=0000000000000000000000000000000000000000
MANTICORE_URL=http://manticore:9308
SEARCH_HYBRID=0
REDIS_URL=redis://redis:6379
RAW_STORAGE_MINIO_ROOT_USER=minioadmin
RAW_STORAGE_MINIO_ROOT_PASSWORD=minioadmin
# Server images run NODE_ENV=production and refuse the filesystem raw store.
# These point at the Compose MinIO profile used when SMOKE_RAW_STORAGE=1.
RAW_S3_BUCKET=ji-raw-local
RAW_S3_ENDPOINT=http://raw-storage-minio:9000
RAW_S3_REGION=us-east-1
RAW_S3_ACCESS_KEY_ID=minioadmin
RAW_S3_SECRET_ACCESS_KEY=minioadmin
