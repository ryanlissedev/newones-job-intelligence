{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catapulze.local/schemas/performance-record-v1.json",
  "title": "Catapulze performance record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "attempt",
    "retryOf",
    "label",
    "executor",
    "runKind",
    "command",
    "commandFingerprint",
    "cohortDimensions",
    "cohortFingerprint",
    "measurement",
    "startedAt",
    "endedAt",
    "durationMs",
    "commandExitCode",
    "commandStatus",
    "wrapperStatus",
    "measurementError",
    "git",
    "runtime",
    "resources",
    "metadata"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "retryOf": { "type": ["string", "null"] },
    "label": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "executor": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "runKind": { "enum": ["cold", "unknown", "warm"] },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "commandFingerprint": { "$ref": "#/$defs/sha256" },
    "cohortDimensions": { "$ref": "#/$defs/cohortDimensions" },
    "cohortFingerprint": { "$ref": "#/$defs/sha256" },
    "measurement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "boundary", "unit"],
          "properties": {
            "kind": { "const": "command-wall-clock" },
            "boundary": { "const": "subprocess-spawn-to-exit" },
            "unit": { "const": "milliseconds" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "boundary", "unit"],
          "properties": {
            "kind": { "const": "in-process-monotonic" },
            "boundary": {
              "type": "string",
              "enum": [
                "search-parser",
                "search-adapter",
                "search-engine",
                "search-facets",
                "search-serialization",
                "search-summary",
                "ingest-queuewait",
                "ingest-discover",
                "ingest-fetch",
                "ingest-raw-write",
                "ingest-normalisation",
                "ingest-dedupe",
                "ingest-commit",
                "ingest-outbox",
                "ingest-index-projection",
                "api-handler",
                "db-poolwait",
                "db-query",
                "db-transaction",
                "db-locks",
                "instrumentation-overhead"
              ]
            },
            "unit": { "const": "milliseconds" }
          }
        }
      ]
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic subprocess wall-clock duration in milliseconds."
    },
    "commandExitCode": { "type": ["integer", "null"] },
    "commandStatus": { "enum": ["passed", "failed", "not-started"] },
    "wrapperStatus": {
      "enum": ["complete", "spawn-failed", "evidence-write-failed"]
    },
    "measurementError": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "message"],
          "properties": {
            "stage": { "enum": ["spawn", "evidence-write"] },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "dirty"],
      "properties": {
        "sha": { "type": ["string", "null"] },
        "dirty": { "type": ["boolean", "null"] }
      },
      "description": "Observed source state; deliberately excluded from cohort identity."
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bun",
        "os",
        "osRelease",
        "arch",
        "cpuCount",
        "cpuModel",
        "memoryBytes"
      ],
      "properties": {
        "bun": { "type": "string" },
        "os": { "type": "string" },
        "osRelease": { "type": "string" },
        "arch": { "type": "string" },
        "cpuCount": { "type": "integer", "minimum": 1 },
        "cpuModel": { "type": "string" },
        "memoryBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpuUserMicroseconds",
        "cpuSystemMicroseconds",
        "maxRssBytes",
        "unsupportedReason"
      ],
      "properties": {
        "cpuUserMicroseconds": { "type": ["integer", "null"], "minimum": 0 },
        "cpuSystemMicroseconds": { "type": ["integer", "null"], "minimum": 0 },
        "maxRssBytes": { "type": ["integer", "null"], "minimum": 0 },
        "unsupportedReason": { "type": ["string", "null"] }
      }
    },
    "metadata": { "$ref": "#/$defs/metadata" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "commandStatus": { "const": "passed" } },
        "required": ["commandStatus"]
      },
      "then": { "properties": { "commandExitCode": { "const": 0 } } }
    },
    {
      "if": {
        "properties": { "commandStatus": { "const": "not-started" } },
        "required": ["commandStatus"]
      },
      "then": { "properties": { "commandExitCode": { "type": "null" } } }
    },
    {
      "if": {
        "properties": { "commandStatus": { "const": "failed" } },
        "required": ["commandStatus"]
      },
      "then": {
        "properties": {
          "commandExitCode": { "type": "integer", "not": { "const": 0 } }
        }
      }
    },
    {
      "if": {
        "properties": { "wrapperStatus": { "const": "complete" } },
        "required": ["wrapperStatus"]
      },
      "then": { "properties": { "measurementError": { "type": "null" } } }
    },
    {
      "if": {
        "properties": { "wrapperStatus": { "const": "spawn-failed" } },
        "required": ["wrapperStatus"]
      },
      "then": {
        "properties": {
          "commandStatus": { "const": "not-started" },
          "measurementError": {
            "type": "object",
            "required": ["stage"],
            "properties": { "stage": { "const": "spawn" } }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "wrapperStatus": { "const": "evidence-write-failed" } },
        "required": ["wrapperStatus"]
      },
      "then": {
        "properties": {
          "measurementError": {
            "type": "object",
            "required": ["stage"],
            "properties": { "stage": { "const": "evidence-write" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableString": { "type": ["string", "null"] },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "required": ["dataset"] },
          "then": { "required": ["dataset-digest"] }
        }
      ],
      "properties": {
        "branch": { "type": "string" },
        "cache-state": { "type": "string" },
        "commit": { "type": "string" },
        "concurrency": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,14}|[1-8][0-9]{15}|900(?:[0-6][0-9]{12}|70[0-9]{11}|71[0-8][0-9]{10}|719[0-8][0-9]{9}|7199[0-1][0-9]{8}|71992[0-4][0-9]{7}|719925[0-3][0-9]{6}|7199254[0-6][0-9]{5}|71992547[0-3][0-9]{4}|7199254740[0-8][0-9]{2}|71992547409[0-8][0-9]|719925474099[01]))$"
        },
        "dataset": { "type": "string" },
        "dataset-digest": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "error-count": { "type": "string" },
        "freshness-ms": { "type": "string" },
        "instrumentation-overhead-ms": { "type": "string" },
        "item-count": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,14}|[1-8][0-9]{15}|900(?:[0-6][0-9]{12}|70[0-9]{11}|71[0-8][0-9]{10}|719[0-8][0-9]{9}|7199[0-1][0-9]{8}|71992[0-4][0-9]{7}|719925[0-3][0-9]{6}|7199254[0-6][0-9]{5}|71992547[0-3][0-9]{4}|7199254740[0-8][0-9]{2}|71992547409[0-8][0-9]|719925474099[01]))$"
        },
        "index-state": { "type": "string" },
        "job": { "type": "string" },
        "machine": { "type": "string" },
        "percentile-p50": { "type": "string" },
        "percentile-p95": { "type": "string" },
        "percentile-p99": { "type": "string" },
        "pipeline": { "type": "string" },
        "profile": { "type": "string" },
        "postgres-image-digest": { "type": "string" },
        "postgres-version": { "type": "string" },
        "provider": { "type": "string" },
        "query-identity": { "type": "string" },
        "queryset-digest": { "type": "string" },
        "records-per-second": { "type": "string" },
        "region": { "type": "string" },
        "result-digest": { "type": "string" },
        "runner": { "type": "string" },
        "sequence-position": {
          "type": "string",
          "pattern": "^(?:[1-9]|[1-9][0-9]{1,2}|[1-9][0-9]{3}|10000)$"
        },
        "suite": { "type": "string" },
        "timeout-count": { "type": "string" },
        "throughput-rps": { "type": "string" },
        "toolchain": { "type": "string" },
        "vacuum-state": { "type": "string" },
        "workflow": { "type": "string" },
        "workload-version": { "type": "string" }
      }
    },
    "cohortDimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "label",
        "executor",
        "runKind",
        "commandFingerprint",
        "provider",
        "runner",
        "machine",
        "region",
        "os",
        "arch",
        "bun",
        "osRelease",
        "cpuCount",
        "cpuModel",
        "memoryBytes",
        "toolchain",
        "cacheState",
        "workflow",
        "job",
        "pipeline",
        "suite",
        "workloadVersion",
        "workloadProfile",
        "datasetDigest",
        "querysetDigest",
        "itemCount",
        "concurrency",
        "postgresImageDigest",
        "postgresVersion",
        "indexState",
        "vacuumState"
      ],
      "properties": {
        "version": { "const": 2 },
        "label": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "executor": { "type": "string" },
        "runKind": { "enum": ["cold", "unknown", "warm"] },
        "commandFingerprint": { "$ref": "#/$defs/sha256" },
        "provider": { "$ref": "#/$defs/nullableString" },
        "runner": { "$ref": "#/$defs/nullableString" },
        "machine": { "type": "string" },
        "region": { "$ref": "#/$defs/nullableString" },
        "os": { "type": "string" },
        "arch": { "type": "string" },
        "bun": { "type": "string" },
        "osRelease": { "type": "string" },
        "cpuCount": { "type": "integer", "minimum": 1 },
        "cpuModel": { "type": "string" },
        "memoryBytes": { "type": "integer", "minimum": 1 },
        "toolchain": { "$ref": "#/$defs/nullableString" },
        "cacheState": { "$ref": "#/$defs/nullableString" },
        "workflow": { "$ref": "#/$defs/nullableString" },
        "job": { "$ref": "#/$defs/nullableString" },
        "pipeline": { "$ref": "#/$defs/nullableString" },
        "suite": { "$ref": "#/$defs/nullableString" },
        "workloadVersion": { "$ref": "#/$defs/nullableString" },
        "workloadProfile": { "$ref": "#/$defs/nullableString" },
        "datasetDigest": { "$ref": "#/$defs/nullableString" },
        "querysetDigest": { "$ref": "#/$defs/nullableString" },
        "itemCount": { "type": ["integer", "null"], "minimum": 0 },
        "concurrency": { "type": ["integer", "null"], "minimum": 0 },
        "postgresImageDigest": { "$ref": "#/$defs/nullableString" },
        "postgresVersion": { "$ref": "#/$defs/nullableString" },
        "indexState": { "$ref": "#/$defs/nullableString" },
        "vacuumState": { "$ref": "#/$defs/nullableString" }
      }
    }
  }
}
