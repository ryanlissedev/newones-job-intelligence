{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catapulze.local/schemas/effect-baseline-artifact-v1.json",
  "title": "Catapulze EffectTS platform baseline artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "issue",
    "adr",
    "status",
    "git",
    "host",
    "toolchain",
    "cohort",
    "workload",
    "metrics",
    "retryOwnership",
    "allowedRegressions",
    "reviewRubric",
    "notes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "issue": {
      "type": "string",
      "pattern": "^CTP-[0-9]+$"
    },
    "adr": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["template", "dry-run", "measured", "invalid"]
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headSha", "dirty"],
      "properties": {
        "headSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "branch": {
          "type": ["string", "null"]
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "os", "arch", "cpuCount", "memTotalMiB"],
      "properties": {
        "hostname": {
          "type": "string"
        },
        "os": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "cpuCount": {
          "type": "integer",
          "minimum": 1
        },
        "memTotalMiB": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bunPackageManager",
        "bunHost",
        "typescript",
        "typesBun",
        "effectDirect",
        "effectTransitive",
        "compatibilityNotes"
      ],
      "properties": {
        "bunPackageManager": {
          "type": "string"
        },
        "bunHost": {
          "type": "string"
        },
        "typescript": {
          "type": "string"
        },
        "typesBun": {
          "type": "string"
        },
        "effectDirect": {
          "type": ["string", "null"]
        },
        "effectTransitive": {
          "type": ["string", "null"]
        },
        "compatibilityNotes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runKind", "cacheState", "label"],
      "properties": {
        "runKind": {
          "enum": ["cold", "warm", "unknown"]
        },
        "cacheState": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapters", "fixtureOnly", "liveProviders"],
      "properties": {
        "adapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "json-ld-listing",
              "json-ld-detail",
              "spott-list",
              "spott-get"
            ]
          }
        },
        "fixtureOnly": {
          "type": "boolean"
        },
        "liveProviders": {
          "type": "boolean"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latencyMs",
        "attemptCounts",
        "cancellationLatencyMs",
        "resourceReleaseOk",
        "peakRssMiB",
        "buildDurationMs",
        "typecheckDurationMs",
        "serverBundleBytes",
        "directDependencyCount",
        "adapterLocObserve"
      ],
      "properties": {
        "latencyMs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["p50", "p95", "n", "failures"],
          "properties": {
            "p50": {
              "type": ["number", "null"]
            },
            "p95": {
              "type": ["number", "null"]
            },
            "n": {
              "type": "integer",
              "minimum": 0
            },
            "failures": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "attemptCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestAttempts", "taskAttempts"],
          "properties": {
            "requestAttempts": {
              "type": ["number", "null"]
            },
            "taskAttempts": {
              "type": ["number", "null"]
            }
          }
        },
        "cancellationLatencyMs": {
          "type": ["number", "null"]
        },
        "resourceReleaseOk": {
          "type": ["boolean", "null"]
        },
        "peakRssMiB": {
          "type": ["number", "null"]
        },
        "buildDurationMs": {
          "type": ["number", "null"]
        },
        "typecheckDurationMs": {
          "type": ["number", "null"]
        },
        "serverBundleBytes": {
          "type": ["integer", "null"]
        },
        "directDependencyCount": {
          "type": ["integer", "null"]
        },
        "adapterLocObserve": {
          "type": ["integer", "null"]
        }
      }
    },
    "retryOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestRetryOwner",
        "triggerTaskRetryOwner",
        "requestMaxAttempts",
        "triggerMaxAttempts",
        "blindWriteRetries"
      ],
      "properties": {
        "requestRetryOwner": {
          "type": "string"
        },
        "triggerTaskRetryOwner": {
          "type": "string"
        },
        "requestMaxAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "triggerMaxAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "blindWriteRetries": {
          "const": false
        }
      }
    },
    "allowedRegressions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewRubric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retryOwnerIdentifiable",
        "cancellationPathIdentifiable",
        "cleanupOwnerIdentifiable",
        "notes"
      ],
      "properties": {
        "retryOwnerIdentifiable": {
          "type": ["boolean", "null"]
        },
        "cancellationPathIdentifiable": {
          "type": ["boolean", "null"]
        },
        "cleanupOwnerIdentifiable": {
          "type": ["boolean", "null"]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
