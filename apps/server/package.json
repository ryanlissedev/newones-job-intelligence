{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "auth:provision": "bun src/auth/provision-user.ts",
    "build": "PATH=\"./node_modules/.bin:$PATH\" tsdown",
    "check-types": "PATH=\"./node_modules/.bin:$PATH\" tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "export:reconcile-spott": "bun src/export/reconcile-spott-export.ts",
    "projector": "bun src/projector/main.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.2",
    "@ji/api": "workspace:*",
    "@ji/application": "workspace:*",
    "@ji/auth": "workspace:*",
    "@ji/db": "workspace:*",
    "@ji/env": "workspace:*",
    "@ji/performance": "workspace:*",
    "@ji/search": "workspace:*",
    "@modelcontextprotocol/hono": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@trpc/server": "catalog:",
    "ai": "7.0.97",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "effect": "catalog:",
    "hono": "catalog:",
    "postgres": "^3.4.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.13",
    "@ji/config": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/bun": "catalog:",
    "tsdown": "^0.22.14",
    "typescript": "catalog:"
  }
}
