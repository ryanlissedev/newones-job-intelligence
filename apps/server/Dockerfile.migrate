# checkov:skip=CKV_DOCKER_2:One-shot migrator; Coolify health_check_enabled=false (no Docker health instruction).
FROM oven/bun:1.3.14@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4 AS builder
WORKDIR /app
ENV SKIP_ENV_VALIDATION=1

COPY . .
RUN --mount=type=cache,target=/root/.bun/install/cache bun install --frozen-lockfile --ignore-scripts

ENV NODE_ENV=production
RUN cd apps/server && bun run build

FROM oven/bun:1.3.14@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4 AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --chown=bun:bun --from=builder /app /app
RUN mkdir -p /app/.turbo && chown bun:bun /app/.turbo

USER bun
# One-shot migrator: do not add a Docker health instruction. Coolify substring-matches
# that keyword in this file and then expects .State.Health. Keep health_check_enabled=false
# on the Coolify migrator app (see hetzner-deploy.md).
# Coolify runs this container with restart=unless-stopped and ignores
# custom_docker_run_options=--restart=no, so a clean exit-0 migrator restart-loops
# forever. On success park the container so it shows Up and runs exactly once per
# deploy; on failure the non-zero exit still makes Coolify retry.
CMD ["sh", "-c", "bun run db:migrate && exec tail -f /dev/null"]
