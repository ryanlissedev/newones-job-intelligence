# Copy to apps/server/.env and fill in real values.
# Generate BETTER_AUTH_SECRET with: openssl rand -base64 32

DATABASE_URL=postgresql://ji_app:ji_app_local@127.0.0.1:5432/ji_test
MIGRATION_DATABASE_URL=postgresql://ji_migrator:ji_migrator_local@127.0.0.1:5432/ji_test
# Required only by `bun run projector`: direct, non-pooler connection for the
# session advisory lock. In Neon production use the same branch/database and
# app role as DATABASE_URL, but select the direct endpoint (no `-pooler`).
PROJECTOR_DATABASE_URL=postgresql://ji_app:ji_app_local@127.0.0.1:5432/ji_test
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# Operator-only one-shot auth provisioning. Keep disabled during normal app
# runtime. Inject real values with 1Password; never place them in this file.
AUTH_BOOTSTRAP_ENABLED=0
AUTH_BOOTSTRAP_CONFIRM=replace-with-confirmation-phrase
AUTH_BOOTSTRAP_EMAIL=user@example.invalid
AUTH_BOOTSTRAP_NAME=Example User
AUTH_BOOTSTRAP_PASSWORD=replace-with-strong-password
AUTH_BOOTSTRAP_ROLE=recruiter
NODE_ENV=development
# Public deployed Git SHA for /version and guarded live E2E release proof.
# Replace this placeholder during deployment; it is not a secret.
APP_RELEASE_SHA=0000000000000000000000000000000000000000

# Search index (U6). Compose defaults to http://127.0.0.1:9308 on the host.
MANTICORE_URL=http://127.0.0.1:9308
# Manticore 29 hybrid search candidate. Default remains lexical/off.
SEARCH_HYBRID=0

# EffectTS production enablement (CTP-479 / Slice 14) — default OFF.
# Enable ONE surface at a time in Coolify; see docs/runbooks/effectts-production-enablement.md
JI_EFFECT_DB=0
JI_EFFECT_SERVER=0
PERF_EFFECT_SPANS=0

# RJC-387: on-box search projector (`bun run projector`, apps/server/src/projector).
# Reads data through DATABASE_URL above (pooled Neon TLS is allowed), holds
# its session lock through direct PROJECTOR_DATABASE_URL, and writes to
# MANTICORE_URL above (loopback-only in production: http://127.0.0.1:9308).
# Run this process on the Manticore host, not in the cloud worker — see
# docs/runbooks/search-projector.md. Pair with apps/worker's
# SEARCH_PROJECTOR=onbox so the worker stops draining inline.
# Search result cache (RJC-388). Unset runs the in-process memory cache;
# compose exposes Redis on 127.0.0.1:6379.
# REDIS_URL=redis://127.0.0.1:6379

# Local raw-object store for ingest smoke (defaults to .data/raw-objects under cwd).
# Filesystem is used only when RAW_S3_BUCKET is unset — production refuses to
# start on the filesystem backend (RJC-386).
RAW_OBJECT_STORE_PATH=

# Durable S3-compatible raw object store (RJC-386). Setting RAW_S3_BUCKET
# selects it over RAW_OBJECT_STORE_PATH above. Local defaults below point at
# the `raw-storage-minio` Compose service: `docker compose --profile storage
# up -d --wait raw-storage-minio raw-storage-minio-init` (bucket ji-raw-local
# is created automatically). minioadmin/minioadmin are MinIO's well-known
# local-only defaults — never use them against a real bucket.
# RAW_S3_BUCKET=ji-raw-local
# RAW_S3_ENDPOINT=http://127.0.0.1:9002
# RAW_S3_REGION=us-east-1
# RAW_S3_ACCESS_KEY_ID=minioadmin
# RAW_S3_SECRET_ACCESS_KEY=minioadmin

# Optional read-only Motian-Neon source for U8 backfill (never commit real values).
# Used only by scripts/backfill-neon-v1.ts and the backfill-neon-v1 worker task.

# Spott.io REST client (optional; production export remains disabled)
# SPOTT_LIVE=1 selects live requests for explicitly constructed clients only.
# The production registry supplies no write client; this flag does not enable export.
SPOTT_API_KEY=

# Marktvragen chat (JI-DSH-07): on-box streamText route at POST
# /marktvragen/chat. Unset key leaves the server booting — the endpoint then
# answers 503 CHAT_NOT_CONFIGURED. Prod runs a free-tier OpenRouter model;
# override per deployment if needed.
# OPENROUTER_API_KEY=sk-or-replace-me
# MARKTVRAGEN_CHAT_MODEL=openai/gpt-oss-120b
# Per-user sliding-window turn budget for the chat endpoint (default 30).
# MARKTVRAGEN_MAX_TURNS_PER_HOUR=30
