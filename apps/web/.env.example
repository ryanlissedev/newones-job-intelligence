# Copy to apps/web/.env

NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Server-only API URL for the Next.js server process (dashboard SSR session
# lookup). docker-compose.yml pins it to http://server:3000 for the web
# service; leave unset for plain local dev to fall back to NEXT_PUBLIC_SERVER_URL.
# INTERNAL_SERVER_URL=http://server:3000

