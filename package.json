{
  "name": "catapulze-job-intelligence",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@tailwindcss/postcss": "^4.3.3",
      "@trpc/client": "^11.18.0",
      "@trpc/server": "^11.18.0",
      "@types/bun": "^1.3.14",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "better-auth": "1.7.1",
      "dotenv": "^17.4.2",
      "effect": "^4.0.0-rc.112",
      "hono": "^4.12.32",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.3",
      "typescript": "^6.0.3",
      "zod": "^4.4.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "PATH=\"./node_modules/.bin:$PATH\" turbo run dev",
    "build": "PATH=\"./node_modules/.bin:$PATH\" turbo run build",
    "check-types": "PATH=\"./node_modules/.bin:$PATH\" turbo run check-types --concurrency=2",
    "check-types:tsgo": "PATH=\"./node_modules/.bin:$PATH\" sh -c 'for tsconfig in apps/*/tsconfig.json packages/*/tsconfig.json; do echo \"== tsgo $tsconfig\"; tsgo --noEmit -p \"$tsconfig\" || exit 1; done'",
    "check-types:backfill": "PATH=\"./node_modules/.bin:$PATH\" tsc --noEmit -p tools/backfill/tsconfig.json",
    "check-types:production": "PATH=\"./node_modules/.bin:$PATH\" tsc --noEmit -p scripts/production/tsconfig.json",
    "check-types:benchmarks": "PATH=\"./node_modules/.bin:$PATH\" tsc --noEmit -p benchmarks/tsconfig.json",
    "check-types:ci-metrics": "PATH=\"./node_modules/.bin:$PATH\" tsc --noEmit -p scripts/ci-metrics/tsconfig.json",
    "check-types:e2e-live-jobs": "PATH=\"./node_modules/.bin:$PATH\" tsc --noEmit -p e2e/live-jobs/tsconfig.json",
    "check-types:effect-e2e": "PATH=\"./node_modules/.bin:$PATH\" tsc --noEmit -p scripts/effect-e2e/tsconfig.json",
    "check-types:performance": "PATH=\"./node_modules/.bin:$PATH\" tsc --noEmit -p scripts/performance/tsconfig.json",
    "check-types:mcp-edge": "PATH=\"./node_modules/.bin:$PATH\" tsc --noEmit -p scripts/mcp-edge-tsconfig.json",
    "dev:web": "PATH=\"./node_modules/.bin:$PATH\" turbo run dev -F web --",
    "dev:server": "PATH=\"./node_modules/.bin:$PATH\" turbo run dev -F server --",
    "projector": "PATH=\"./node_modules/.bin:$PATH\" turbo run projector -F server --",
    "db:push": "PATH=\"./node_modules/.bin:$PATH\" turbo run db:push -F @ji/db --",
    "db:studio": "PATH=\"./node_modules/.bin:$PATH\" turbo run db:studio -F @ji/db --",
    "db:generate": "PATH=\"./node_modules/.bin:$PATH\" turbo run db:generate -F @ji/db --",
    "db:migrate": "PATH=\"./node_modules/.bin:$PATH\" turbo run db:migrate -F @ji/db --",
    "docker:build": "docker compose build",
    "docker:volume:create": "bash tools/postgres/ensure-volume.sh",
    "e2e:live:jobs": "PATH=\"./node_modules/.bin:$PATH\" bun e2e/live-jobs/run.ts session",
    "e2e:live:jobs:anonymous": "PATH=\"./node_modules/.bin:$PATH\" bun e2e/live-jobs/run.ts anonymous",
    "e2e:live:jobs:anonymous:discover": "PATH=\"./node_modules/.bin:$PATH\" playwright test --config=playwright.live-anonymous.config.ts --list",
    "e2e:live:jobs:discover": "PATH=\"./node_modules/.bin:$PATH\" playwright test --config=playwright.live.config.ts --list",
    "e2e:live:jobs:writes": "PATH=\"./node_modules/.bin:$PATH\" bun e2e/live-jobs/run.ts writes",
    "e2e:live:jobs:writes:discover": "PATH=\"./node_modules/.bin:$PATH\" playwright test --config=playwright.live-writes.config.ts --list",
    "e2e:effect:local": "bash scripts/effect-e2e/run.sh",
    "e2e:live:bron-dashboard:discover": "PATH=\"./node_modules/.bin:$PATH\" playwright test --config=playwright.live.config.ts --list e2e/live-jobs/bron-dashboard.playwright.ts",
    "demo:preflight": "PATH=\"./node_modules/.bin:$PATH\" bun scripts/demo/preflight.ts",
    "demo:record": "PATH=\"./node_modules/.bin:$PATH\" bun scripts/demo/record.ts",
    "demo:smoke-cursor-vo": "PATH=\"./node_modules/.bin:$PATH\" bun scripts/demo/smoke-cursor-vo.ts",
    "demo:record-search": "PATH=\"./node_modules/.bin:$PATH\" bun scripts/demo/record-search-tour.ts",
    "export:reconcile-spott": "bun apps/server/src/export/reconcile-spott-export.ts",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:smoke": "bash scripts/docker-compose-smoke.sh",
    "docker:mcp-edge-smoke": "bash scripts/mcp-edge-smoke.sh",
    "check": "PATH=\"./node_modules/.bin:$PATH\" bash tools/quality/check-changed.sh",
    "check:all": "PATH=\"./node_modules/.bin:$PATH\" ultracite check",
    "fix": "PATH=\"./node_modules/.bin:$PATH\" bash tools/quality/fix-changed.sh",
    "fix:all": "PATH=\"./node_modules/.bin:$PATH\" ultracite fix",
    "gate": "PATH=\"./node_modules/.bin:$PATH\" bash tools/quality/gate.sh",
    "gate:timed": "PATH=\"./node_modules/.bin:$PATH\" PERF_METRICS_DIR=\"${PERF_METRICS_DIR:-.artifacts/performance/gate}\" bash tools/quality/gate.sh",
    "wiki": "openwiki code --update --print",
    "test": "PATH=\"./node_modules/.bin:$PATH\" bun test --max-concurrency 2 --path-ignore-patterns '**/dist/**'",
    "test:e2e": "e2e run",
    "test:e2e-live-jobs:config": "PATH=\"./node_modules/.bin:$PATH\" bun test --max-concurrency 2 apps/server/src/http/release.spec.ts e2e/live-jobs/config.spec.ts e2e/live-jobs/harness.spec.ts e2e/live-jobs/session-verifier.spec.ts e2e/live-jobs/bron-dashboard-parity.spec.ts",
    "test:timed": "PATH=\"./node_modules/.bin:$PATH\" bun scripts/performance/measure.ts --label test -- bun test --max-concurrency 2 --path-ignore-patterns '**/dist/**'",
    "build:timed": "PATH=\"./node_modules/.bin:$PATH\" bun scripts/performance/measure.ts --label build -- turbo run build --concurrency=2",
    "perf:measure": "PATH=\"./node_modules/.bin:$PATH\" bun scripts/performance/measure.ts",
    "perf:report": "PATH=\"./node_modules/.bin:$PATH\" bun scripts/performance/report.ts",
    "check-layering": "PATH=\"./node_modules/.bin:$PATH\" bun scripts/check-layering.ts",
    "check-secrets": "PATH=\"./node_modules/.bin:$PATH\" bun scripts/check-secrets-scan.ts",
    "check:capability-coverage": "PATH=\"./node_modules/.bin:$PATH\" bun scripts/check-capability-coverage.ts",
    "check:capability-registry": "PATH=\"./node_modules/.bin:$PATH\" bun scripts/check-capability-registry.ts",
    "source-to-ui-gap": "PATH=\"./node_modules/.bin:$PATH\" bun scripts/source-to-ui-gap.ts",
    "check:field-coverage": "PATH=\"./node_modules/.bin:$PATH\" bun scripts/check-field-coverage.ts",
    "check:postgres-compose": "PATH=\"./node_modules/.bin:$PATH\" bun scripts/check-postgres-compose.ts",
    "check:production-compose-guard": "PATH=\"./node_modules/.bin:$PATH\" bun scripts/check-production-compose-guard.ts",
    "check:manticore-bench-empty": "PATH=\"./node_modules/.bin:$PATH\" bun tools/quality/assert-manticore-bench-empty.ts",
    "postgres:restore-drill": "bash tools/postgres/restore-drill.sh",
    "bench:search": "PATH=\"./node_modules/.bin:$PATH\" bun benchmarks/search/run.ts",
    "relevance": "PATH=\"./node_modules/.bin:$PATH\" bun benchmarks/relevance/run.ts",
    "relevance:export": "PATH=\"./node_modules/.bin:$PATH\" bun benchmarks/relevance/export-judgments.ts",
    "relevance:import": "PATH=\"./node_modules/.bin:$PATH\" bun benchmarks/relevance/import-judgments.ts",
    "bench:generate": "PATH=\"./node_modules/.bin:$PATH\" bun benchmarks/search/generate-corpus.ts",
    "backfill:neon-v1": "PATH=\"./node_modules/.bin:$PATH\" bun scripts/backfill-neon-v1.ts",
    "replay:run": "PATH=\"./node_modules/.bin:$PATH\" bun run scripts/replay-run.ts",
    "search:new-generation": "PATH=\"./node_modules/.bin:$PATH\" bun tools/manticore/start-search-generation.ts",
    "search:reconcile-projection": "PATH=\"./node_modules/.bin:$PATH\" bun tools/search/reconcile-projection.ts",
    "prepare": "PATH=\"./node_modules/.bin:$PATH\" lefthook install --reset-hooks-path",
    "bench:bron-dashboard": "PATH=\"./node_modules/.bin:$PATH\" bun benchmarks/bron-dashboard/run.ts",
    "bench:worker-slots": "PATH=\"./node_modules/.bin:$PATH\" bun benchmarks/worker-slots/run.ts",
    "check-types:effect-baseline": "PATH=\"./node_modules/.bin:$PATH\" tsc --noEmit -p scripts/effect-baseline/tsconfig.json",
    "effect-baseline:dry-run": "PATH=\"./node_modules/.bin:$PATH\" bun scripts/effect-baseline/harness.ts --dry-run",
    "effect-baseline:measure": "PATH=\"./node_modules/.bin:$PATH\" bun scripts/effect-baseline/harness.ts --measure",
    "audit:dpg-consent-fetch": "PATH=\"./node_modules/.bin:$PATH\" bun scripts/audit/dpg-consent-fetch.ts",
    "backfill:renormalise-from-raw": "PATH=\"./node_modules/.bin:$PATH\" bun tools/backfill/renormalise-from-raw.ts"
  },
  "dependencies": {
    "@ji/env": "workspace:*",
    "@ji/search": "workspace:*",
    "dotenv": "catalog:",
    "effect": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@e2e-dev/web": "0.11.2",
    "@ji/application": "workspace:*",
    "@ji/config": "workspace:*",
    "@ji/connectors": "workspace:*",
    "@ji/db": "workspace:*",
    "@ji/domain": "workspace:*",
    "@ji/performance": "workspace:*",
    "@ji/search": "workspace:*",
    "@oxlint/plugins": "1.80.0",
    "@playwright/test": "^1.62.1",
    "@types/bun": "catalog:",
    "@types/picomatch": "2.3.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "drizzle-orm": "^0.45.2",
    "e2e": "0.16.0",
    "hono": "catalog:",
    "lefthook": "2.1.10",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "picomatch": "2.3.1",
    "playwright": "1.63.0",
    "postgres": "^3.4.7",
    "turbo": "^2.10.7",
    "typescript": "catalog:",
    "ultracite": "7.9.4"
  },
  "packageManager": "bun@1.3.14"
}
