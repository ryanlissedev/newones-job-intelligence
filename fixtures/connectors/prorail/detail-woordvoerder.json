  "payload": "\n\n\n<!DOCTYPE html>\n<html lang=\"nl\" dir=\"ltr\">\n<head>\n\n    <meta charset=\"UTF-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <meta name=\"format-detection\" content=\"telephone=no\">\n    <link rel=\"icon\" href=\"/static/favicon.ico\">\n    <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/static/apple-touch-icon.png\">\n    <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/static/favicon-32x32.png\">\n    <link rel=\"icon\" type=\"image/png\" sizes=\"150x150\" href=\"/static/mstile-150x150.png\">\n\n    <title>Woordvoerder | Werken bij ProRail</title>\n\n    <link rel=\"preload\" href=\"/static/werkenbij.js?v=20260917072000\" as=\"script\" crossorigin=\"anonymous\" />\n    <link rel=\"prefetch\" as=\"script\" href=\"https://cdn1.readspeaker.com/script/6539/ReadSpeaker.js?pids=embhl\" />\n\n        <link rel=\"stylesheet\" href=\"/static/css/werkenbij-D5tWcgqd.css\" type=\"text/css\"/>\n        <link rel=\"stylesheet\" href=\"/static/css/vue-cookies-Ds_YmOBQ.css\" type=\"text/css\"/>\n    \n    \n\n        <link rel=\"preconnect\" href=\"https://consentcdn.cookiebot.com\">\n        \n        \n\n    \n        <link rel=\"modulepreload\" href=\"/static/js/vue-cookies-C3NKyQ6a.js\" />\n        <link rel=\"modulepreload\" href=\"/static/js/prorail-modal-If0joDoA.js\" />\n\n    \n\n\n\n        <meta name=\"description\" content=\"Sta midden in de actualiteit en vertel als woordvoerder van ProRail het juiste verhaal, juist als de druk hoog is. &#x20AC; 5.091 tot &#x20AC; 7.262 Utrecht\">\n\n    <!-- Open graph meta tags-->\n    <meta property=\"og:url\" content=\"https://www.werkenbijprorail.nl/vacatures/functie/woordvoerder\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:title\" content=\"Woordvoerder\" />\n        <meta property=\"og:description\" content=\"Sta midden in de actualiteit en vertel als woordvoerder van ProRail het juiste verhaal, juist als de druk hoog is. &#x20AC; 5.091 tot &#x20AC; 7.262 Utrecht\" />\n        <meta property=\"og:image\" content=\"https://www.werkenbijprorail.nl/siteassets/vacature-headers/staf--support/duckdev-prorail-22042024-1854-verbeterd-nr-low.jpg?width=600&amp;height=315&amp;mode=crop&amp;scale=down&amp;v=914261435\" />\n        <meta property=\"og:image:secure_url\" content=\"https://www.werkenbijprorail.nl/siteassets/vacature-headers/staf--support/duckdev-prorail-22042024-1854-verbeterd-nr-low.jpg?width=600&amp;height=315&amp;mode=crop&amp;scale=down&amp;v=914261435\" />\n\n    <link href=\"https://www.werkenbijprorail.nl/vacatures/functie/woordvoerder\" rel=\"canonical\" />\n            <script type=\"application/ld+json\">\n                {\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"@id\":\"https://www.werkenbijprorail.nl/#organization\",\"name\":\"ProRail\",\"sameAs\":[\"https://www.facebook.com/ProRail\",\"https://www.instagram.com/werkenbijprorail\",\"https://nl.linkedin.com/company/prorail\",\"https://www.youtube.com/user/prorail\"],\"url\":\"https://www.werkenbijprorail.nl/\",\"address\":{\"@type\":\"PostalAddress\",\"name\":\"ProRail\",\"addressCountry\":\"NL\",\"addressLocality\":\"Utrecht\",\"postalCode\":\"3500 GA\",\"streetAddress\":\"Postbus 2038\"},\"legalName\":\"ProRail B.V.\",\"location\":{\"@type\":\"PostalAddress\",\"name\":\"ProRail\",\"addressCountry\":\"NL\",\"addressLocality\":\"Utrecht\",\"postalCode\":\"3511 EP \",\"streetAddress\":\"Moreelsepark 3\"},\"logo\":\"https://www.werkenbijprorail.nl/static/assets/brands/werkenbij/images/logo_werkenbij.svg\"}\n            </script>\n            <script type=\"application/ld+json\">\n                {\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://www.werkenbijprorail.nl/#website\",\"name\":\"Werken bij ProRail\",\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":\"https://www.werkenbijprorail.nl/vacatures?Q={query}\",\"query\":\"optional\"},\"url\":\"https://www.werkenbijprorail.nl/\",\"publisher\":{\"@type\":\"Organization\",\"@id\":\"https://www.werkenbijprorail.nl/#organization\"}}\n            </script>\n            <script type=\"application/ld+json\">\n                {\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://www.werkenbijprorail.nl/vacatures/functie/woordvoerder\",\"name\":\"Woordvoerder\",\"description\":\"Sta midden in de actualiteit en vertel als woordvoerder van ProRail het juiste verhaal, juist als de druk hoog is. \\u20AC 5.091 tot \\u20AC 7.262 Utrecht\",\"url\":\"https://www.werkenbijprorail.nl/vacatures/functie/woordvoerder\",\"datePublished\":\"2026-09-17\",\"isPartOf\":{\"@type\":\"WebSite\",\"@id\":\"https://www.werkenbijprorail.nl/#website\"},\"publisher\":{\"@type\":\"Organization\",\"@id\":\"https://www.werkenbijprorail.nl/#organization\"}}\n            </script>\n            <script type=\"application/ld+json\">\n                {\"@context\":\"https://schema.org\",\"EducationalLevel\":\"hbo/wo\",\"@type\":\"JobPosting\",\"title\":\"Woordvoerder\",\"description\":\"\\n\\u003Cp\\u003EAls woordvoerder ben jij de stem van ProRail in een veelzijdige regio: Limburg, Noord-Brabant, Zeeland, Zuid-Holland en een deel van Gelderland. Samen met een collega ben je verantwoordelijk voor de woordvoering in dit gebied. Je adviseert over regionale \\u00E9n landelijke dossiers en zorgt dat ProRail zichtbaar, begrijpelijk en betrouwbaar wordt vertegenwoordigd. Werkzaamheden waar je aan kunt denken:\\u003C/p\\u003E\\n\\u003Cul\\u003E\\u003Cli\\u003EJe bent het eerste aanspreekpunt voor media bij regionale en landelijke onderwerpen en ontwikkelingen.\\u003C/li\\u003E\\u003Cli\\u003EJe adviseert bestuur, management en collega\\u2019s over media-optredens, woordvoering en reputatie.\\u003C/li\\u003E\\u003Cli\\u003EJe anticipeert op ontwikkelingen in politiek, media en samenleving, herkent reputatierisico\\u2019s en zorgt dat ProRail voorbereid is op wat op ons afkomt.\\u003C/li\\u003E\\u003C/ul\\u003E\\n\\u003Cp\\u003EWerken bij ProRail is heel dynamisch. Geen dag is hetzelfde. Bij incidenten of andere urgente situaties kan er een beroep op je worden gedaan. Daarom draai je ook piketdiensten en ben je tijdens deze diensten 24/7 bereikbaar. Hiervoor ontvang je een extra vergoeding van \\u20AC 450,- bruto.\\u003Ci\\u003E  \\u003C/i\\u003E\\u003C/p\\u003E\\n\\n\\n\",\"image\":\"https://www.werkenbijprorail.nl/siteassets/vacature-headers/staf--support/duckdev-prorail-22042024-1854-verbeterd-nr-low.jpg\",\"url\":\"https://www.werkenbijprorail.nl/vacatures/functie/woordvoerder\",\"applicationContact\":{\"@type\":\"ContactPoint\",\"email\":\"redacted@example.invalid\"},\"baseSalary\":{\"@type\":\"MonetaryAmount\",\"currency\":\"EUR\",\"maxValue\":7262,\"minValue\":5091},\"datePosted\":\"2026-09-17\",\"directApply\":true,\"educationRequirements\":\"hbo/wo\",\"employmentType\":\"Full-time\",\"employmentUnit\":{\"@type\":\"Organization\",\"address\":{\"@type\":\"PostalAddress\",\"addressCountry\":\"Nederland\",\"addressLocality\":\"Utrecht\",\"addressRegion\":\"NL\",\"postalCode\":\"3511 EP\"},\"legalName\":\"Utrecht, De Inktpot\"},\"estimatedSalary\":{\"@type\":\"MonetaryAmount\",\"currency\":\"EUR\",\"maxValue\":7262,\"minValue\":5091},\"hiringOrganization\":{\"@type\":\"Organization\",\"name\":\"ProRail\",\"address\":{\"@type\":\"PostalAddress\",\"addressCountry\":\"Nederland\",\"addressLocality\":\"Utrecht\",\"addressRegion\":\"NL\",\"postalCode\":\"3511 EP\"},\"legalName\":\"ProRail\"},\"jobBenefits\":\"\\n\\u003Cul\\u003E\\u003Cli\\u003EDirect een vast contract. Wij hebben vertrouwen in jou.\\u003C/li\\u003E\\u003Cli\\u003EEen bruto maandsalaris tussen \\u20AC 5.091,- en \\u20AC 7.262,- o.b.v. 36 uur per week, schaal 9.\\u003C/li\\u003E\\u003Cli\\u003EDaarbovenop 13,61% van jouw bruto salaris in de vorm van een Individueel KeuzeBudget (IKB). Dit budget is inclusief 8% vakantietoeslag en 3,25% decemberuitkering.\\u003C/li\\u003E\\u003Cli\\u003EEen goed pensioen bij Rail \\u0026amp; OV: een sterk fonds dat vooroploopt in duurzaam beleggen.\\u003Cbr /\\u003EZit je nu in een ander fonds? Houd er rekening mee dat Rail \\u0026amp; OV op 1 januari 2026 al overstapte op het nieuwe pensioenstelsel\\u003C/li\\u003E\\u003Cli\\u003EEen NS-Business Card met TreinVrij (en een NS-Businesscard Daluren voor directe gezinsleden). Of een kilometervergoeding van \\u20AC 0,25/km onbelast bij maximaal 120 kilometer per dag.\\u003C/li\\u003E\\u003Cli\\u003EEen persoonlijk ontwikkelbudget tot \\u20AC 1.000,- per jaar. En veel mogelijkheden voor vakinhoudelijke studies en trainingen. Ontwikkelen is bij ProRail de normaalste zaak.\\u003Cbr /\\u003E\\u003C/li\\u003E\\u003C/ul\\u003E\\n\\u003Cp\\u003EWij kozen voor een kleine selectie uit onze arbeidsvoorwaarden. Maar we bieden je meer. Voor alle arbeidsvoorwaarden en onze CAO klik op \\u003Ca href=\\u0022/link/01d1616b557e4ddebc724fd927e63688.aspx\\u0022\\u003Edeze link\\u003C/a\\u003E. \\u003C/p\\u003E\\n\",\"jobLocation\":{\"@type\":\"Place\",\"address\":{\"@type\":\"PostalAddress\",\"addressCountry\":\"Nederland\",\"addressLocality\":\"Utrecht\",\"addressRegion\":\"NL\",\"postalCode\":\"3511 EP\"}},\"salaryCurrency\":\"EUR\",\"validThrough\":\"2026-10-08\",\"workHours\":\"32-36\"}\n            </script>\n\n    \n</head>\n<body >\n    <!-- Google Tag Manager (noscript) -->\r\n<noscript><iframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-WTGP3LM\" height=\"0\" width=\"0\" style=\"display:none;visibility:hidden\"></iframe></noscript>\r\n<!-- End Google Tag Manager (noscript) -->\n\n    \n    \n\n    <div class=\"prorail werkenbij\">\n\n        <div id=\"drawer-portal\"></div>\n\n        <p class=\"skiplinks background-secondary\">\n            <span>Direct naar de &nbsp;</span><a href=\"#inhoud\">inhoud</a><span>.</span><span class=\"helper\"></span>\n        </p>\n\n            <header class=\"header navigation-wrapper\">\n                \n\n\n\n\n\n\n            </header>\n\n        <main class=\"page vacature-page\" role=\"main\" id=\"inhoud\" data-page='{\n  \"type\": \"VacaturePage\"\n}'>\n            <section class=\"image-text-header full is-jobpage\" data-vacancy=\"{&#xA;  &quot;name&quot;: &quot;Woordvoerder&quot;,&#xA;  &quot;id&quot;: &quot;382300&quot;,&#xA;  &quot;price&quot;: 1,&#xA;  &quot;quantity&quot;: 1,&#xA;  &quot;category&quot;: &quot;Staf &amp; advies,Communicatie en externe betrekkingen&quot;,&#xA;  &quot;variant&quot;: &quot;public&quot;,&#xA;  &quot;hours&quot;: &quot;32-36&quot;,&#xA;  &quot;education&quot;: &quot;hbo/wo&quot;,&#xA;  &quot;city&quot;: &quot;Utrecht&quot;,&#xA;  &quot;salary&quot;: &quot;&#x20AC; 5.091 tot &#x20AC; 7.262&quot;&#xA;}\"\n         >\n    <div class=\"wrapper\">\n        <div class=\"content\">\n            <div class=\"vacancy-header\">\n                <div class=\"vacancy-header-information \">\n                    <h1>Woordvoerder</h1>\n                    <span class=\"visually-hidden\">Categorie:</span>\n                    <span class=\"vacancy-header-category\">Staf &amp; advies | Communicatie en externe betrekkingen</span>\n\n\n                </div>\n                <prorail-favorite large class=\"rs_preserve\" id=\"my-job-id\" favorite-id=\"382300\" favorite-name=\"vacaturefav\" label-save=\"Bewaar vacature\" label-saved=\"Bewaard\" v-cloak>\n                    <form method=\"post\" action=\"/api/v1/VacancyFavorite/toggle\">\n                        <input id=\"vacature_favorite_recordid\" name=\"vacature.favorite.recordid\" type=\"hidden\" value=\"382300\" />\n                        <button type=\"submit\" class=\"secondary-simple\">Bewaar vacature</button>\n                    </form>\n                </prorail-favorite>\n            </div>\n\n            <ul class=\"clean\">\n                <li class=\"bgicon-money-werkenbij\"><span class=\"visually-hidden\">Salaris:</span>&#x20AC; 5.091 tot &#x20AC; 7.262</li>\n                <li class=\"bgicon-clock-werkenbij\"><span class=\"visually-hidden\">Dienstverband:</span>32-36 uur</li>\n                <li class=\"bgicon-certificate-werkenbij\"><span class=\"visually-hidden\">Opleidingsniveau:</span>hbo/wo</li>\n                <li class=\"bgicon-hotspot-werkenbij\"><span class=\"visually-hidden\">Locatie:</span>Utrecht</li>\n            </ul>\n            \n            <span class=\"cta-wrapper\">\n                    <div class=\"vacancy-button-wrapper--inline\" js-vacancy-apply-inline>\n                        <a class=\"button bgicon-arrow-after primary-simple\" href=\"/vacatures/functie/woordvoerder?form=1#solliciteer-nu\">\n                            Solliciteer v&#xF3;&#xF3;r 08 okt 2026\n                        </a>\n                    </div>\n            </span>\n            \n                    <div class=\"vacancy-button-wrapper--floating hidden background-primary\" js-vacancy-apply-floating>\n                        <div class=\"vacancy-button-wrapper--floating-content\">\n                            <a class=\"button bgicon-arrow-after primary-simple\" href=\"/vacatures/functie/woordvoerder?form=1#solliciteer-nu\">\n                                Solliciteer v&#xF3;&#xF3;r 08 okt 2026\n                            </a>\n                            <prorail-favorite large class=\"rs_preserve\" id=\"my-job-id\" favorite-id=\"382300\" favorite-name=\"vacaturefav\" label-save=\"Bewaar vacature\" label-saved=\"Bewaard\" v-cloak>\n                                <form method=\"post\" action=\"/api/v1/VacancyFavorite/toggle\">\n                                    <input id=\"vacature_favorite_recordid\" name=\"vacature.favorite.recordid\" type=\"hidden\" value=\"382300\" />\n                                    <button type=\"submit\" class=\"secondary-simple\">Bewaar vacature</button>\n                                </form>\n                            </prorail-favorite>\n                        </div>\n                    </div>\n\n        </div>\n    </div>\n    <div class=\"image\">\n        <div class=\"vacancy-label-wrapper\">\n        </div>\n        <div class=\"deco-overlay\">\n            <div class=\"deco-parts\">\n                <div class=\"entry\"></div>\n                <div class=\"part-1\"></div>\n                <div class=\"part-2\"></div>\n                <div class=\"part-3\"></div>\n                <div class=\"part-4\"></div>\n                <div class=\"exit\"></div>\n            </div>\n        </div>\n        <img src=\"/siteassets/vacature-headers/staf--support/duckdev-prorail-22042024-1854-verbeterd-nr-low.jpg?width=1200&amp;rmode=crop&amp;rxy=0.62,0.12&amp;format=webp\" \n             srcset=\"/siteassets/vacature-headers/staf--support/duckdev-prorail-22042024-1854-verbeterd-nr-low.jpg?width=640&amp;rmode=crop&amp;rxy=0.62,0.12&amp;format=webp 640w, /siteassets/vacature-headers/staf--support/duckdev-prorail-22042024-1854-verbeterd-nr-low.jpg?width=900&amp;rmode=crop&amp;rxy=0.62,0.12&amp;format=webp 900w, /siteassets/vacature-headers/staf--support/duckdev-prorail-22042024-1854-verbeterd-nr-low.jpg?width=1200&amp;rmode=crop&amp;rxy=0.62,0.12&amp;format=webp 1200w, /siteassets/vacature-headers/staf--support/duckdev-prorail-22042024-1854-verbeterd-nr-low.jpg?width=1200&amp;rmode=crop&amp;rxy=0.62,0.12&amp;format=webp\"\n             sizes=\"(min-width: 900px) 50vw, (min-width: 1920px) 960px, 100vw\"\n             fetchpriority=\"high\"\n             alt=\"\"\n             style=\"object-position: 74% 0%\" />\n        <div class=\"nav-image-backdrop\"></div>\n    </div>\n    \n\n</section>\n<section class=\"job-text\">\n    <div class=\"job-text__company-info\" >\n        <strong>\n            <p>Sta midden in de actualiteit en vertel als woordvoerder van ProRail het juiste verhaal, juist als de druk hoog is.<br></p>\n\n        </strong>\n    </div>\n    <div class=\"faq faq-jobtext\">\n           \n                <prorail-accordion jobpage controls=\"faq\" open>\n                    <template #controls>\n                        <h2 class=\"h3\">Werk om trots op te zijn</h2>\n                    </template>\n                    <div>\n<p>Als woordvoerder ben jij de stem van ProRail in een veelzijdige regio: Limburg, Noord-Brabant, Zeeland, Zuid-Holland en een deel van Gelderland. Samen met een collega ben je verantwoordelijk voor de woordvoering in dit gebied. Je adviseert over regionale én landelijke dossiers en zorgt dat ProRail zichtbaar, begrijpelijk en betrouwbaar wordt vertegenwoordigd. Werkzaamheden waar je aan kunt denken:</p>\n<ul><li>Je bent het eerste aanspreekpunt voor media bij regionale en landelijke onderwerpen en ontwikkelingen.</li><li>Je adviseert bestuur, management en collega’s over media-optredens, woordvoering en reputatie.</li><li>Je anticipeert op ontwikkelingen in politiek, media en samenleving, herkent reputatierisico’s en zorgt dat ProRail voorbereid is op wat op ons afkomt.</li></ul>\n<p>Werken bij ProRail is heel dynamisch. Geen dag is hetzelfde. Bij incidenten of andere urgente situaties kan er een beroep op je worden gedaan. Daarom draai je ook piketdiensten en ben je tijdens deze diensten 24/7 bereikbaar. Hiervoor ontvang je een extra vergoeding van € 450,- bruto.<i>  </i></p>\n\n\n</div>\n                </prorail-accordion>\n                <prorail-accordion jobpage controls=\"faq\" >\n                    <template #controls>\n                        <h2 class=\"h3\">Jouw plek</h2>\n                    </template>\n                    <div v-cloak=\"\">\n<p>We bieden graag ruimte aan iedereen. Daarbij zien we talent als basis en diversiteit als kracht om samen betere resultaten te behalen. Voor jou als woordvoerder is er plek op de afdeling Communicatie &amp; Externe Betrekkingen, in het team Media &amp; Creatie.</p>\n<p>Je komt terecht in een hecht team met professionals die het gezicht en de stem zijn van ProRail. Maar samen denk je ook na hoe je collega’s – die misschien nog nooit voor een camera hebben gestaan – ook een podium kunt geven. Je krijgt hierbij veel vrijheid en vertrouwen. Naast het harde werken is er ook voldoende ruimte om af en toe met elkaar stoom af te blazen in een café op loopafstand van onze kantoren.<br></p>\n</div>\n                </prorail-accordion>\n                <prorail-accordion jobpage controls=\"faq\" >\n                    <template #controls>\n                        <h2 class=\"h3\">Jouw arbeidsvoorwaarden</h2>\n                    </template>\n                    <div v-cloak=\"\">\n<ul><li>Direct een vast contract. Wij hebben vertrouwen in jou.</li><li>Een bruto maandsalaris tussen € 5.091,- en € 7.262,- o.b.v. 36 uur per week, schaal 9.</li><li>Daarbovenop 13,61% van jouw bruto salaris in de vorm van een Individueel KeuzeBudget (IKB). Dit budget is inclusief 8% vakantietoeslag en 3,25% decemberuitkering.</li><li>Een goed pensioen bij Rail &amp; OV: een sterk fonds dat vooroploopt in duurzaam beleggen.<br>Zit je nu in een ander fonds? Houd er rekening mee dat Rail &amp; OV op 1 januari 2026 al overstapte op het nieuwe pensioenstelsel</li><li>Een NS-Business Card met TreinVrij (en een NS-Businesscard Daluren voor directe gezinsleden). Of een kilometervergoeding van € 0,25/km onbelast bij maximaal 120 kilometer per dag.</li><li>Een persoonlijk ontwikkelbudget tot € 1.000,- per jaar. En veel mogelijkheden voor vakinhoudelijke studies en trainingen. Ontwikkelen is bij ProRail de normaalste zaak.<br></li></ul>\n<p>Wij kozen voor een kleine selectie uit onze arbeidsvoorwaarden. Maar we bieden je meer. Voor alle arbeidsvoorwaarden en onze CAO klik op <a href=\"/link/01d1616b557e4ddebc724fd927e63688.aspx\">deze link</a>. </p>\n</div>\n                </prorail-accordion>\n                <prorail-accordion jobpage controls=\"faq\" >\n                    <template #controls>\n                        <h2 class=\"h3\">Jouw inbreng </h2>\n                    </template>\n                    <div v-cloak=\"\">\n<p>Bij ProRail vinden wij het belangrijk dat jij gewoon jezelf kan zijn. Daarom zijn wij benieuwd naar wie jij bent. Voor deze functie breng je sowieso mee: <br></p>\n<ul><li>Hbo/wo denk- en werkniveau met minimaal een afgerond hbo diploma in relevante richting.</li><li>Minstens 5 jaar ervaring als strategisch woordvoerder.</li><li>Ervaring in een politiek-bestuurlijke context.</li><li>Energie om met het team steeds door te ontwikkelen in het woordvoerdersvak.</li><li>Gezelligheid en een gezonde portie relativeringsvermogen.<br></li></ul>\n</div>\n                </prorail-accordion>\n                <prorail-accordion jobpage controls=\"faq\" >\n                    <template #controls>\n                        <h2 class=\"h3\">Jouw sollicitatie</h2>\n                    </template>\n                    <div v-cloak=\"\">\n<p>Wil je als woordvoerder werken aan de toekomst van Nederland én aan die van jezelf? Solliciteer vóór donderdag 8 oktober 2026. Toch eerst nog een vraag? Stel deze gerust aan Roos Bleijenburg via <a href=\"mailto:redacted@example.invalid\">redacted@example.invalid</a>.  Voor inhoudelijke vragen kun je contact opnemen met de manager Andy Wiemer via <a href=\"mailto:redacted@example.invalid\">redacted@example.invalid</a>.</p>\n<p>Binnen 5 dagen na de sluitingsdatum krijg je onze reactie. De eerste gespreksronde staat gepland in de week van 12 en 19 oktober. Concrete data volgt z.s.m. Uitgenodigd voor een vervolggesprek? Dan vragen we je thuis een casus voor te bereiden die je in het tweede gesprek kan pitchen. Het opvragen van een referentie kan onderdeel zijn van jouw sollicitatieproces.</p>\n<p>Word jij onze nieuwe collega? Dan hoort het aanvragen van een VOG tot de indiensttredingsprocedure. De kosten voor de VOG krijg je terug nadat je bent gestart.</p></div>\n                </prorail-accordion>\n                <prorail-accordion jobpage controls=\"faq\" >\n                    <template #controls>\n                        <h2 class=\"h3\">Jouw ProRail</h2>\n                    </template>\n                    <div v-cloak=\"\"><p>Bij de naam ProRail denken veel mensen in eerste instantie aan treinen. Toch zit het net even anders: we beheren de spoorwegnetwerken in Nederland. En wist je dat we in Nederland een van de drukste, betrouwbaarste en meest ingenieuze spoorwegnetwerken ter wereld kennen?</p>\n<p>Hoe fijn is het dan ook dat we kunnen rekenen op onze ruim 5.000 diverse collega’s. Met elkaar houden we 7.000 kilometer spoor – en alles wat erbij komt kijken – veilig en in topconditie. Van mooie stations en een optimale dienstregeling tot goed onderhouden bruggen, tunnels, overgangen, wissels en seinen.</p></div>\n                </prorail-accordion>\n        </div>\n    \n</section>\n\n\n\n\n\n<section class=\"vacancy-share-block\">\n    <div class=\"content\">\n        <ul class=\"vacancy-share\">\n            <li class=\"background-septenary\">\n                <a href=\"https://wa.me/?text=https%3A%2F%2Fwww.werkenbijprorail.nl%2Fvacatures%2Ffunctie%2Fwoordvoerder\" target=\"_blank\" rel=\"nofollow noreferrer\">\n\t\t\t\t\t<span class=\"button primary primary-simple round bgicon-whatsapp-after\">\n\t\t\t\t\t\t<span>Deel deze vacature via Whatsapp</span>\n\t\t\t\t\t</span>\n\t\t\t\t</a>\n\n                <a href=\"mailto:?subject=Werken%20bij%20ProRail&amp;body=https%3A%2F%2Fwww.werkenbijprorail.nl%2Fvacatures%2Ffunctie%2Fwoordvoerder\" target=\"_blank\" rel=\"nofollow noreferrer\">\n                    <span class=\"button primary primary-simple round bgicon-mail-after\">\n                        <span>Deel deze vacature via de mail</span>\n                    </span>\n                </a>\n                <span class=\"label-text\" aria-hidden=\"true\">\n                    Deel deze vacature\n                </span>\n\t\t\t</li>\n\n        </ul>\n    </div>\n</section>\n\n\n\n\n\n<section class=\"steps is-primary\" v-background-helper>\n    <div class=\"top\">\n        <div class=\"content\">\n            <h2>Jouw sollicitatieproces</h2>\n\n                <div class=\"content-intro rich-text\">\n                    <p>Solliciteren bij ProRail? We vinden het belangrijk dat je weet waar je aan toe bent. Daarom nemen we je stap voor stap mee in ons sollicitatieproces.</p>\n                </div>\n\n                <div class=\"content-quote\">\n                        <img class=\"content-photo\" src=\"/siteassets/fotos-2024/duckdev-prorail-11062024-9624-verbeterd-nr-low.jpg?width=620&amp;height=324&amp;rmode=crop&amp;rxy=0.47,0.52&amp;format=webp\" alt=\"\" loading=\"lazy\" width=\"620\" height=\"324\" />\n\n                        <blockquote class=\"clean content-moreinfo\">\n                            <p>&ldquo;Wat jouw rol ook is, samen zorgen we ervoor dat Nederland in beweging blijft.&rdquo;</p>\n                        </blockquote>\n                </div>\n\n            <div class=\"content-right\">\n                    <prorail-steps-accordion>\n                            <template #header-0>\n                                <div>Sollicitatie</div>\n                            </template>\n                            <template #content-0>\n                                    <div class=\"content-description\">Met jouw sollicitatie zit je op het juiste spoor naar jouw droombaan. Onze recruiter bekijkt of je aansluit op de vacature en stuurt jouw gegevens door naar de vacaturehouder.</div>\n                            </template>\n                            <template #header-1>\n                                <div>Kennismakingsgesprek</div>\n                            </template>\n                            <template #content-1>\n                                    <div class=\"content-description\">Zijn we overtuigd van jouw cv en motivatie, dan nodigen we je persoonlijk uit voor een kennismaking bij ons op kantoor.</div>\n                            </template>\n                            <template #header-2>\n                                <div>Online assessment</div>\n                            </template>\n                            <template #content-2>\n                                    <div class=\"content-description\">Om je beter te leren kennen vragen we je thuis een online test te maken. De uitkomst bespreken we na jouw akkoord tijdens de gesprekken. </div>\n                            </template>\n                            <template #header-3>\n                                <div>Vervolggesprek</div>\n                            </template>\n                            <template #content-3>\n                                    <div class=\"content-description\">Is de kennismaking voor jou en ons goed verlopen, dan gaan we weer een stap vooruit met het vervolggesprek. </div>\n                            </template>\n                            <template #header-4>\n                                <div>Aanbieding</div>\n                            </template>\n                            <template #content-4>\n                                    <div class=\"content-description\">Wij zijn overtuigd en hopen jij ook. We nemen je graag aan en je ontvangt een arbeidsvoorwaardenvoorstel dat jou past.</div>\n                            </template>\n                            <template #header-5>\n                                <div>Aangenomen. Gefeliciteerd!</div>\n                            </template>\n                            <template #content-5>\n                                    <div class=\"content-description\">Je hebt ons aanbod geaccepteerd. Je wordt onze nieuwe collega. We dragen je over aan de afdeling HR die met jou de arbeidsovereenkomst in orde maakt. </div>\n                            </template>\n                    </prorail-steps-accordion>\n\n                    <a href=\"/vacatures/functie/woordvoerder?form=1#solliciteer-nu\" class=\"button primary contrast-icon\">\n                            <span>Solliciteer vóór 08 okt 2026</span>\n                    </a>\n            </div>\n        </div>\n    </div>\n</section>\n\n\n\n    <section class=\"faq vacancy-faq background-senary\" v-background-helper>\n        <div class=\"content\">\n            <div class=\"left\">\n                        <h2>Voor al je vragen over werken bij ProRail</h2>\n                <ul>\n                        <li>\n                            <prorail-accordion controls=\"faq\">\n                                <template #controls>\n                                    <h3>Heb ik spoorervaring nodig voor een functie binnen Staf & Advies?</h3>\n                                </template>\n                                <div v-cloak class=\"rich-text\">\n                                    <p>Nee, spoorervaring heb je niet nodig. Voor de meeste functies binnen Staf &amp; Advies is ervaring in je eigen vakgebied belangrijker. Kennis van mobiliteit of infrastructuur kan helpen, maar is meestal geen vereiste.&nbsp;</p>\n<p>Wat wel helpt, is interesse in de omgeving waarin ProRail werkt. Je werkt bij een organisatie met een belangrijke maatschappelijke opdracht: Nederland bereikbaar houden. Dat doen we als beheerder van een van de drukste spoornetwerken van Europa. Daarbij spelen thema's als infrastructuur, duurzaamheid, mobiliteit, belangen van politiek en bestuur en publieke verantwoording een belangrijke rol. Onze lijnen zijn kort maar niet altijd even snel. Maar ProRail is volop in beweging, waarbij we samenwerken aan resultaat voor de reiziger, de verlader en de omgeving.</p>\n<p>Als je energie krijgt van een maatschappelijke relevante organisatie, voel je je binnen ProRail vaak snel thuis.</p>\n                                </div>\n                            </prorail-accordion>\n                        </li>\n                        <li>\n                            <prorail-accordion controls=\"faq\">\n                                <template #controls>\n                                    <h3>Welke functies zijn er binnen Staf & Advies bij ProRail?</h3>\n                                </template>\n                                <div v-cloak class=\"rich-text\">\n                                    <p>Binnen Staf &amp; Advies zijn er veel verschillende functies, van HR-adviseurs tot juristen en van planners tot ecologen. Je werkt namelijk binnen een van de afdelingen die ProRail ondersteunen en adviseren: Human Resource Management, Communicatie &amp; Externe Betrekkingen, Human Facility Management, Capaciteitsmanagement en Leefomgeving en Juridische Zaken &amp; Vastgoed.</p>\n                                </div>\n                            </prorail-accordion>\n                        </li>\n                        <li>\n                            <prorail-accordion controls=\"faq\">\n                                <template #controls>\n                                    <h3>Hoe draag ik vanuit Staf & Advies bij aan de bereikbaarheid van Nederland?</h3>\n                                </template>\n                                <div v-cloak class=\"rich-text\">\n                                    <p>Misschien niet altijd direct zichtbaar, maar ook binnen Staf &amp; Advies bij ProRail draag je bij aan de bereikbaarheid van Nederland.</p>\n<p>ProRail kan haar werk alleen goed doen als de juiste mensen, middelen, processen en samenwerkingen op orde zijn. Daar leveren de afdelingen binnen Staf &amp; Advies een belangrijke bijdrage aan.</p>\n<p>Zo zorgt HR voor het aantrekken, ontwikkelen en behouden van collega's. Communicatie &amp; Externe Betrekkingen verbindt ProRail met reizigers, omwonenden, media en bestuurders. Human Facility Management zorgt voor een prettige en goed ingerichte werkomgeving. Capaciteitsmanagement werkt aan de verdeling van ruimte op het spoor. Leefomgeving zorgt voor een goede balans tussen het spoor en de omgeving. En Juridische Zaken &amp; Vastgoed ondersteunt bij juridische vragen en het beheer van gronden en gebouwen.</p>\n<p>Welke afdeling of functie je ook hebt, jouw werk helpt collega's in de operatie, projecten en techniek om Nederland bereikbaar te houden. &nbsp;</p>\n                                </div>\n                            </prorail-accordion>\n                        </li>\n                        <li>\n                            <prorail-accordion controls=\"faq\">\n                                <template #controls>\n                                    <h3>Wat maakt werken binnen Staf & Advies bij ProRail interessant?</h3>\n                                </template>\n                                <div v-cloak class=\"rich-text\">\n                                    <p>Binnen ProRail komen veel verschillende belangen samen. We willen Nederland bereikbaar houden, werken steeds meer op een duurzame mainier aan het spoor en investeren in de toekomst. Tegelijk houden we rekening met reizigers, vervoerders, omwonenden, gemeenten, provincies en de Rijksoverheid.</p>\n<p>Daardoor krijg je vaak te maken met onderwerpen die verder gaan dan je eigen expertise. Of je nu werkt in HR, Communicatie &amp; Externe Betrekkingen, Human Facility Management, Capaciteitsmanagement, Leefomgeving of Juridische Zaken &amp; Vastgoed: je werkt samen met collega's uit verschillende afdelingen om tot de beste oplossing te komen.</p>\n<p>Dat maakt het werk afwisselend en uitdagend. Je kijkt niet alleen naar je eigen expertise, maar ook naar de invloed van jouw keuzes op de reiziger, de verlader en de omgeving.</p>\n                                </div>\n                            </prorail-accordion>\n                        </li>\n                </ul>\n                    <a href=\"https://www.werkenbijprorail.nl/faq?C=System.Collections.Generic.List`1%5bSystem.Int32%5d\" title=\"Meer vragen over Staf &amp; advies\" class=\"button primary color-secondary\">Meer vragen</a>\n            </div>\n            <div class=\"right\">\n                <div class=\"recruiter\">\n                    <img src=\"/siteassets/recruiters/roos-3.jpg?width=366&amp;height=366&amp;rmode=crop&amp;rxy=0.43,0.33&amp;format=webp\" alt=\"\" loading=\"lazy\" width=\"366\" height=\"366\" />\n                    <div class=\"recruiter-info\">\n                            <h3>Vragen over het sollicitatieproces</h3>\n                            <p>Neem contact op met <b>Roos  Bleijenburg</b> via <a href=\"mailto:redacted@example.invalid\">redacted@example.invalid</a></p>\n\n                    </div>\n                </div>\n                \n            </div>\n\n        </div>\n    </section>\n\n\n\n\r\n    <section class=\"related-testimonials swiper-overview wide no-spacing \" v-background-helper>\n            <h2>Laat je inspireren door toekomstige collega&#x27;s</h2>\n\n            <prorail-swiper-overview class=\"deco-container\">\n                    <li class=\"swiper-slide\" v-cloak>\n                        <blockquote class=\"h6 clean\">\n                            <a href=\"/collegas-aan-het-woord/savana-ter-burg\">\n                                <span class=\"image lazyload\" data-bg=\"/siteassets/testimonials-2025/savana-ter-burg-1.jpg?format=webp&amp;width=510\"></span>\n                                <span class=\"content\">Savana maakt als adviseur omgevingscommunicatie het verschil door begrijpelijke en verbindende communicatie.</span>\n                                <span class=\"button link\"><span visual-only-content=\"Lees meer\"></span><span class=\"visually-hidden\"></span></span>\n                            </a>\n                        </blockquote>\n                    </li>\n                    <li class=\"swiper-slide\" v-cloak>\n                        <blockquote class=\"h6 clean\">\n                            <a href=\"/collegas-aan-het-woord/ramona-ezink\">\n                                <span class=\"image lazyload\" data-bg=\"/siteassets/fotos/duckdev-prorai-ramona-4046-low.jpg?format=webp&amp;width=510\"></span>\n                                <span class=\"content\">Ramona houdt zich als adviseur omgevingscommunnicatie voornamelijk bezig met alle buren langs het spoor.</span>\n                                <span class=\"button link\"><span visual-only-content=\"Lees meer\"></span><span class=\"visually-hidden\"></span></span>\n                            </a>\n                        </blockquote>\n                    </li>\n                    <li class=\"swiper-slide\" v-cloak>\n                        <blockquote class=\"h6 clean\">\n                            <a href=\"/collegas-aan-het-woord/marlon-turk\">\n                                <span class=\"image lazyload\" data-bg=\"/siteassets/fotos/duckdev-prorail-marlon-0119-low.jpg?format=webp&amp;width=510\"></span>\n                                <span class=\"content\">Marlon zorgt er als bedrijfsjurist voor dat aanbestedingen volgens de wet- en regelgeving verloopt.</span>\n                                <span class=\"button link\"><span visual-only-content=\"Lees meer\"></span><span class=\"visually-hidden\"></span></span>\n                            </a>\n                        </blockquote>\n                    </li>\n            </prorail-swiper-overview>\n\n            <p class=\"swiper-overview__cta-wrapper\">\n                <a class=\"button primary swiper-overview__cta\" href=\"/collegas-aan-het-woord\">Naar alle verhalen</a>\n            </p>\n\n    </section>\n\n\n\n\n\n<section class=\"travel rs_preserve\" id=\"travel-widget\">\n    <div class=\"top\">\n        <div class=\"content\">\n            <prorail-form>\n                <form action=\"/vacatures/functie/woordvoerder/DistanceMatrixes#travel-widget\" method=\"post\">\n                    <input name=\"__RequestVerificationToken\" type=\"hidden\" value=\"CfDJ8Dj6XQ4e_g1BkrIXV191vJGo-pC3PgokqJ0RyrCOx07k-4itC60lVw9A94YOzacgtyofd-v8PZ_jfvJ5ab6rL0BVFtghn_gWu3uv5fbCVp2J8YyCBChdSUvwG6L1ooJC3Vpa-JTUV8uPNJFhhGKJQSo\" />\n\n                    <fieldset class=\"travel-fieldset\">\n                        <legend class=\"travel-legend\">Bereken je reistijd</legend>\n                        <div class=\"tavel-formgroup\">\n                            <prorail-autosuggest url=\"/api/v1/googlemaps/placeautocomplete\"\n                                                class=\"travel-field field\"\n                                                reset reset-label=\"Adres leegmaken\">\n                                <input id=\"Origin\" name=\"Origin\" Placeholder=\"Bijvoorbeeld: Traverse 3, Veenendaal\" Required=\"True\" type=\"text\" value=\"\" />\n                                <label for=\"Origin\">Van</label>\n                                <p class=\"invalid\">Je hebt het verplichte veld Van nog niet ingevuld. Vul hier je adres is. </p>\n                            </prorail-autosuggest>\n\n                            <div class=\"travel-field\">\n                                <strong class=\"travel-label\">Naar</strong>\n                                <span class=\"travel-input\">Inktpot, Moreelsepark 3, Utrecht, Nederland</span>\n                            </div>\n                        </div>\n\n                        <button type=\"submit\" name=\"travel-submit\" class=\"primary travel-submit\">Bereken je reistijd</button>\n                    </fieldset>\n                </form>\n            </prorail-form>\n        </div>\n    </div>\n</section>\n\n\n\n\n\n<section class=\"related-vacancies wide background-senary\" v-background-helper>\n    <div class=\"heading-container\">\n        <h2>Wellicht vind je deze vacatures ook interessant</h2>\n    </div>\n\n        <section class=\"swiper-overview wide\">\n            <div id=\"vacature-list\" class=\"content\">\n                <prorail-swiper-overview class=\"deco-container\" slides=\"1.04\" gap=\"18\" center=\"false\">\n                        <li data-vacancy=\"{&#xA;  &quot;location&quot;: 1,&#xA;  &quot;list&quot;: &quot;Vacature Page&quot;,&#xA;  &quot;name&quot;: &qu