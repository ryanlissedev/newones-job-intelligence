                       <div>Aangenomen. Gefeliciteerd!</div>\n                            </template>\n                            <template #content-4>\n                                    <div class=\"content-description\">Je hebt ons aanbod geaccepteerd. Je wordt onze nieuwe collega. We dragen je over aan de afdeling HR die met jou de arbeidsovereenkomst in orde maakt. </div>\n                            </template>\n                    </prorail-steps-accordion>\n\n            </div>\n        </div>\n    </div>\n</section>\n\n\n\n    \n\n\n\n\r\n    <section class=\"related-testimonials swiper-overview wide no-spacing \" v-background-helper>\n            <h2>Laat je inspireren door toekomstige collega&#x27;s</h2>\n\n            <prorail-swiper-overview class=\"deco-container\">\n                    <li class=\"swiper-slide\" v-cloak>\n                        <blockquote class=\"h6 clean\">\n                            <a href=\"/collegas-aan-het-woord/gerben-van-dijke\">\n                                <span class=\"image lazyload\" data-bg=\"/siteassets/testimonials-2025/duckdev-prorail-16062024-6008-low.jpg?format=webp&amp;width=510\"></span>\n                                <span class=\"content\">Gerben houdt als chief information security officer dagelijkse cyberaanvallen buiten de deur.</span>\n                                <span class=\"button link\"><span visual-only-content=\"Lees meer\"></span><span class=\"visually-hidden\"></span></span>\n                            </a>\n                        </blockquote>\n                    </li>\n                    <li class=\"swiper-slide\" v-cloak>\n                        <blockquote class=\"h6 clean\">\n                            <a href=\"/collegas-aan-het-woord/evy-kalker\">\n                                <span class=\"image lazyload\" data-bg=\"/contentassets/ffa7169bdbad4ef5a4ff43cb65552d46/duckdev-prorail-11122024-8710-verbeterd-nr-low.jpg?format=webp&amp;width=510\"></span>\n                  