l,null,null,null,null,null,null,null,null,null,22,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,14,null,null,null,15,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,{\"loading\":10,\"userDetails\":11,\"jobAlertCategories\":672,\"jobAlertSnoozeDate\":11,\"proxyCandidates\":673,\"myCandidates\":674,\"myCandidatesLoaded\":10,\"enrolments\":675,\"savedJobAlert\":10,\"jobAlertQuery\":676},[],[],[],[],{},{\"loading\":10,\"favourites\":678},[],{\"loading\":10,\"statsLoading\":10,\"vacancies\":680,\"relatedVacancies\":738,\"pageSize\":231,\"offset\":16,\"loadMoreVacancies\":10,\"loadMoreLoading\":10,\"relatedVacanciesLoading\":8,\"queryData\":739,\"defaultSearchFilters\":755,\"numberOfCheckboxFiltersApplied\":16,\"vacanciesCount\":770,\"vacancyCategories\":774,\"selectedLocation\":11,\"selectedRate\":11,\"selectedHours\":11},[681],{\"tender_id\":682,\"web_key\":683,\"tender_name\":684,\"tender_buying_organization\":685,\"tender_source\":686,\"tender_date\":687,\"tender_url\":688,\"tender_job_location\":689,\"tender_tariff\":11,\"tender_maximum_tariff\":690,\"tender_no_max_tariff\":10,\"tender_min_hours\":553,\"tender_max_hours\":553,\"tender_hours_week\":691,\"tender_gross_monthly_salary\":692,\"tender_duration_months\":112,\"tender_hybrid_working\":10,\"contract_type\":693,\"exclusive\":11,\"oim_vacancy\":10,\"direct_recruitment_vacancy\":10,\"tender_approved_in_cms\":8,\"experience_level\":538,\"education_level\":286,\"extension_option_description\":694,\"remote_work_description\":695,\"vacancy_metadescription\":696,\"tender_overview\":697,\"tender_description_html\":698,\"tender_requirements\":699,\"tender_competences\":700,\"tender_team\":701,\"tender_interview\":319,\"tender_number_of_professionals\":702,\"tender_other_information\":703,\"tender_first_seen\":704,\"tender_last_seen\":705,\"tender_start_date\":706,\"tender_end_date\":707,\"tender_offline_date\":708,\"tender_status\":709,\"similarity_score\":16,\"vacancies_location\":710,\"organization_location\":717,\"tender_categories\":724,\"transient_favourite_user\":737},\"circle8_rijkswaterstaat_VNR-85296\",\"4E70E935-2B6C-422E-83C7-7A9E3A810A99\",\"Adviseur Dynamisch Verkeersmanagement Vaarwegen WNZ\",\"Rijkswaterstaat\",\"circle8_rijkswaterstaat\",\"2026-09-18 00:00:00\",\"https://rijkswaterstaat.circle8.nl/vacature/adviseur-dynamisch-verkeersmanagement-vaarwegen-wnz_VNR-85296\",\"Rotterdam\",105,\"32\",6089.83,\"detachering\",\"Ja, er is een optie tot verlenging voor 2 x 12 maanden.\",\"Werklocatie is in overleg. De teamlocatie is Rotterdam, Haarlem en Utrecht.\",\"Als adviseur dynamisch verkeersmanagement vaarwegen bij Rijkswaterstaat beheer je contracten en bereid je aanbestedingen voor. Solliciteer nu!\",\"\\n<p>Nautische verkeersleiders zijn voor de uitvoering van hun werk afhankelijk van een veilig en functioneel goed bediengebouw en van optimaal functionerende radar-, marifonie- en camerasystemen. Voor aanleg, vervanging en het beheer en onderhoud van deze objecten en systemen zijn opdrachtnemers gecontracteerd.</p><p>Doel van de opdracht is het beheersen van lopende contracten en nieuwe voorbereiden. De werkzaamheden omvatten het voorbereiden van aanbestedingen door het doen of laten doen van onderzoeken, planstudies en ontwerpen, het begeleiden van uitvoeringsprojecten en het meedenken in de assetmanagementcyclus van de VTS systemen die RWS in beheer heeft. Kennis van assetmanagement, radars en ervaring met UAV GC contracten is een vereiste. Advisering van de technisch manager bij complexe technische issues, beoordelen van contractuele wijzigingen en afwijkingen (VTWs) en input leveren en actief bijdragen aan het SCB proces. Hiernaast dient een aantal contracten in de eindfase te worden afgerond. Ook het adviseren mbt de toekomstplannen van VTS contracten en het verder professionaliseren van Technisch Management binnen het cluster behoort tot de opdracht. Van een technisch adviseur bij DVM-V wordt verwacht dat hij/zij optreedt op operationeel niveau intern Rijkswaterstaat en met Opdrachtnemers. Waar nodig kan de technisch adviseur optreden als projectleider.</p><h3>De opdracht bestaat uit:</h3><p>Technische advisering bij uitvoeringsprojecten en voorbereiding van uitvoeringsprojecten.</p><p>Deze hoofdcomponenten bestaan uit een aantal deelproducten:</p><ul><li>Technische advisering realisatie en afronding</li><li>Uitvoeren en ondersteunen contractbeheersing op technisch vlak conform SCB</li><li>Adviseren op Wijzigingen (VTW's) en contracten op technisch vlak incl afstemming met de betrokken partijen</li><li>Voorbereiden, bijdragen en oppakken acties Voortgangs- en contractbeheersoverleggen.</li><li>Advisering aan Technisch manager en de rest van het IPM team</li><li>Overleggen met Opdrachtnemer(s)</li></ul><p>Hiernaast kunnen aan deze overeenkomst in onderhandeling met de Opdrachtnemer opdrachten worden toegevoegd ten behoeve van technisch management en coördinerende taken (projectleiding). Hiertoe zal samen met de Opdrachtnemer een specifieke opdracht worden geformuleerd. Deze gezamenlijk uitwerking van de inhoud van de overeenkomst zal worden vastgelegd in een toevoeging aan de overeenkomst.</p><h3>Doel opdracht</h3><p>De opdracht bevat het opleveren van concrete producten alsmede het ad-hoc adviseren. Je levert gedurende de looptijd documenten, analyses en adviezen op die direct inzetbaar zijn in de projectpraktijk en bijdragen aan tijdige en juiste besluitvorming door het projectteam.</p>\",\"<div class=\\\"c-vacancy-paragraph__body-text body-text\\\"><div><h3>Functieomschrijving:</h3><p></p><p><strong>Opdrachtomschrijving </strong></p><p>Nautische verkeersleiders zijn voor de uitvoering van hun werk afhankelijk van een veilig en functioneel goed bediengebouw en van optimaal functionerende radar-, marifonie- en camerasystemen. Voor aanleg, vervanging en het beheer en onderhoud van deze objecten en systemen zijn opdrachtnemers gecontracteerd.</p><p>Doel van de opdracht is het beheersen van lopende contracten en nieuwe voorbereiden. De werkzaamheden omvatten het voorbereiden van aanbestedingen door het doen of laten doen van onderzoeken, planstudies en ontwerpen, het begeleiden van uitvoeringsprojecten en het meedenken in de assetmanagementcyclus van de VTS systemen die RWS in beheer heeft. Kennis van assetmanagement, radars en ervaring met UAV GC contracten is een vereiste. Advisering van de technisch manager bij complexe technische issues, beoordelen van contractuele wijzigingen en afwijkingen (VTWs) en input leveren en actief bijdragen aan het SCB proces. Hiernaast dient een aantal contracten in de eindfase te worden afgerond. Ook het adviseren mbt de toekomstplannen van VTS contracten en het verder professionaliseren van Technisch Management binnen het cluster behoort tot de opdracht. Van een technisch adviseur bij DVM-V wordt verwacht dat hij/zij optreedt op operationeel niveau intern Rijkswaterstaat en met Opdrachtnemers. Waar nodig kan de technisch adviseur optreden als projectleider. </p><p><strong>De opdracht bestaat uit:  </strong></p><p>1. technische advisering bij uitvoeringsprojecten en voorbereiding van uitvoeringsprojecten </p><p>Deze hoofdcomponenten bestaan uit een aantal deelproducten:  </p><p>1. Technische advisering realisatie en afronding </p><p>a) Uitvoeren en ondersteunen contractbeheersing op technisch vlak conform SCB </p><p>b) Adviseren op Wijzigingen (VTW’s) en contracten op technisch vlak incl afstemming met de betrokken partijen </p><p>c)   Voorbereiden, bijdragen en oppakken acties Voortgangs- en contractbeheersoverleggen. </p><p>d) Advisering aan Technisch manager en de rest van het IPM team</p><p>e) Overleggen met Opdrachtnemer(s)</p><p>Hiernaast kunnen aan deze overeenkomst in onderhandeling met de Opdrachtnemer opdrachten worden toegevoegd ten behoeve van technisch management en coördinerende taken (projectleiding). Hiertoe zal samen met de Opdrachtnemer een specifieke opdracht worden geformuleerd. Deze gezamenlijk uitwerking van de inhoud van de overeenkomst zal worden vastgelegd in een toevoeging aan de overeenkomst.  </p><p><strong>Doel opdracht </strong></p><p>De opdracht bevat het opleveren van concrete producten alsmede het ad-hoc adviseren. De opdrachtnemer levert gedurende de looptijd documenten, analyses en adviezen op die direct inzetbaar zijn in de projectpraktijk en bijdragen aan tijdige en juiste besluitvorming door het projectteam. </p><p><strong>Beoordeling van de opdrachtresultaten </strong></p><p>De opdrachtgever beoordeelt de deliverables D1a t/m D1.e op basis van:  </p><p> a) Volledigheid en juistheid van de opgeleverde documenten;  </p><p>b) Toegevoegde waarde van adviezen voor besluitvorming;  </p><p>c) Tijdigheid van oplevering conform afgesproken planning.  </p><p> </p><p></p></div><div><h3>Over de klant:</h3><p></p><p><strong>Rijkswaterstaat:</strong></p><p>Rijkswaterstaat is de uitvoeringsorganisatie van het ministerie van Infrastructuur en Waterstaat en bestaat uit zeven landelijke en zeven regionale organisatieonderdelen. Al meer dan 200 jaar werken we dagelijks aan een veilig, leefbaar en bereikbaar Nederland. We beheren en ontwikkelen de rijkswegen, -vaarwegen en -wateren en zetten in op een duurzame leefomgeving. Samen met anderen werken we aan een land dat beschermd is tegen overstromingen. Waar voldoende groen is, en voldoende en schoon water. En waar je vlot en veilig van A naar B kunt. Samenwerken aan een veilig, leefbaar en bereikbaar Nederland. Dat is Rijkswaterstaat.</p><p></p></div><div><h3>Eisen:</h3><p></p><ul><li>Kandidaat beschikt aantoonbaar over minimaal 3 jaren kennis van en werkervaring met bedrijfskritische systemen zoals radar, marifonie, CCTV en netwerkinfrastructuur behoeve van scheepvaartbegeleiding, waarbij een deel van de kennis opgedaan is buiten Rijkswaterstaat. </li><li>Kandidaat beschikt aantoonbaar over minimaal een HBO opleiding in een technische richting</li><li>Kandidaat beschikt over minimaal 1 referentie van werken met UAV-GC contracten </li><li>Kandidaat beschikt over minimaal 2 jaar aantoonbare werkervaring met Asset Management </li><li>Kandidaat beschikt over minimaal 2 jaar aantoonbare werkervaring met werken met het IPM model </li></ul><p><strong>Werklocatie: In overleg, teamlocatie is Rotterdam, Haarlem en Utrecht</strong> </p><p></p></div><div><h3>Wensen:</h3><p></p><ul><li>De aangeboden kandidaat heeft aantoonbare kennis van en ervaring met nautische verkeerscentrales </li><li>De aangeboden kandidaat heeft aantoonbare kennis van en ervaring met onderhoudsprojecten binnen de Overheid </li></ul><p></p></div><div><h3>Arbeidsvoorwaarden:</h3><p></p><p><strong>Interesse?</strong></p><p>Stuur ons dan uiterlijk <strong>18 September 2026, voor 15:30 uur</strong> je recente CV in <u>Word</u> + onderbouwing van de eisen en wensen (als voorblad) en je all-in uurtarief excl. BTW.</p><p>Bandbreedte tarief: € 96,50/ € 105,25 <strong>GEEN ZZP MOGELIJK!</strong></p><p>Optie tot verlenging : Ja, 30-09-2028, 2 jaar na startdatum. 2 x 12 maanden </p><p>Bijzonderheden AVG: Géén foto. Géén persoonsgegevens zoals (mail)adres, telefoonnummer, geboortedatum, nationaliteit of LinkedIn. Géén leveranciersgegevens mogen zichtbaar zijn op het format. </p><p></p></div></div>\",\"<ul><li>Je beschikt aantoonbaar over minimaal 3 jaren kennis van en werkervaring met bedrijfskritische systemen zoals radar, marifonie, CCTV en netwerkinfrastructuur behoeve van scheepvaartbegeleiding, waarbij een deel van de kennis opgedaan is buiten Rijkswaterstaat.</li><li>Je beschikt aantoonbaar over minimaal een HBO opleiding in een technische richting.</li><li>Je beschikt over minimaal 1 referentie van werken met UAV-GC contracten.</li><li>Je beschikt over minimaal 2 jaar aantoonbare werkervaring met Asset Management.</li><li>Je beschikt over minimaal 2 jaar aantoonbare werkervaring met werken met het IPM model.</li></ul>\",\"<h3>Wensen</h3><ul><li>De aangeboden professional heeft aantoonbare kennis van en ervaring met nautische verkeerscentrales.</li><li>De aangeboden professional heeft aantoonbare kennis van en ervaring met onderhoudsprojecten binnen de Overheid.</li></ul>\",\"<p>Rijkswaterstaat is de uitvoeringsorganisatie van het ministerie van Infrastructuur en Waterstaat en bestaat uit zeven landelijke en zeven regionale organisatieonderdelen. Al meer dan 200 jaar werken we dagelijks aan een veilig, leefbaar en bereikbaar Nederland. We beheren en ontwikkelen de rijkswegen, -vaarwegen en -wateren en zetten in op een duurzame leefomgeving. Samen met anderen werken we aan een land dat beschermd is tegen overstromingen. Waar voldoende groen is, en voldoende en schoon water. En waar je vlot en veilig van A naar B kunt. Samenwerken aan een veilig, leefbaar en bereikbaar Nederland. Dat is Rijkswaterstaat.</p>\",\"1\",\"<p>\\n  Optie tot verlenging: Ja, er is een optie tot verlenging voor 2 x 12 maanden.<br><br>\\n  Hybride: Werklocatie is in overleg. De teamlocatie is Rotterdam, Haarlem en Utrecht.<br><br>\\n  \\n  Overig algemeen: <p>Bijzonderheden AVG: Géén foto. Géén persoonsgegevens zoals (mail)adres, telefoonnummer, geboortedatum, nationaliteit of LinkedIn. Géén leveranciersgegevens mogen zichtbaar zijn op het format.</p><br><br>\\n</p>\",\"2026-09-15\",\"2026-09-17\",\"2026-10-01\",\"2027-10-01\",\"2026-09-17 16:00:00\",\"closed\",{\"tender_buying_organization\":685,\"company_address\":711,\"company_name_google\":685,\"postcode\":712,\"province\":713,\"place_id_google\":685,\"avatar\":714,\"exclusive\":10,\"publish\":8,\"company_display_name\":685,\"latitude\":715,\"longitude\":716},\"Burgemeester Stramanweg 100 B, 1101 EM Amsterdam, Nederland\",\"1101 EM\",\"Noord-Holland\"