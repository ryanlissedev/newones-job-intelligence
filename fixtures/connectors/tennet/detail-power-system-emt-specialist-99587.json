       <div class=\"banne__wrapper grid\">\n            <div class=\"grid__item visibility--tablet-and-desktop\">\n                                    <h2 class=\"banner__text__title title title--06\">\n                        Power System EMT Specialist\n                    </h2>\n                            </div>\n\n            <div class=\"grid__item\">\n                <div role=\"presentation\">\n                    <article class=\"article article--actions\">\n                                    \n                <div class=\"article__content\">\n                            <div class=\"button-bar button-bar--cols-1\">\n                    <div class=\"button-bar__wrap\">\n                        <a class=\"button button--primary\" href=\"https://careers.tennet.eu/nl_NL/careers/ApplicationMethods?jobId=99587\" tabindex=\"0\">\n                            Solliciteren                        </a>\n                    </div>\n                </div>\n\n                    </div>\n    \n                        <div class=\"article__content--wrapper\">\n                                                            \n                                                                                                    \n                                <div class=\"article__icon article__icon--like\">\n                                                                            \n                                        <div class=\"article__icon article__icon--like\">\n                                            <a class=\"saveButton\" href=\"https://careers.tennet.eu/nl_NL/careers/Login?addToFavs=1&amp;favJobId=99587\"></a>\n                                        </div>\n\n                                                                    </div>\n                            \n                            \n\n                                                \n    <div class=\"article__content\">\n        <div class=\"article__icon \">\n            <a class=\"print__button\" data-map=\"attachment-download-link\" href=\"https://careers.tennet.eu/careers/JobDetail/99587/attachment/fcdc4c52-4ae4-48cb-9816-5a7e9eb775c3\" title=\"Vacature downloaden\" target=\"_blank\">\n            </a>\n        </div>\n    </div>\n\n                                                            \n\n            \n        <div class=\"popup popup--share popup--top popup--overflows--left popup--on-click\">\n            <a class=\"button button--share\" aria-haspopup=\"true\" aria-label=\"Deel Power System EMT Specialist in social media\" role=\"button\" tabindex=\"0\" data-au=\"ag-a-66\">\n                <i class=\"button__icon share__button\" aria-hidden=\"true\"></i>\n            </a>\n\n            <div class=\"popup__content\">\n                <div class=\"popup__content__box\">\n                    <ul class=\"list list--share\">\n                                                    <li class=\"list__item cookieconsent-optin-necessary\">\n                                <a id=\"shareButton--facebook-99587\" class=\"shareButton shareButton--facebook tpt_socialShareIcon tpt_socialSharePopupTrigger\" aria-label=\"Power System EMT Specialist  via Facebook delen\" role=\"link\" tabindex=\"0\" target=\"_blank\" href=\"https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Fcareers.tennet.eu%2Fnl_NL%2Fcareers%2FJobDetail%3FentityId%3D2917039%26jobId%3D99587&amp;display=popup\">Facebook</a>\n                            </li>\n                                                    <li class=\"list__item cookieconsent-optin-necessary\">\n                                <a id=\"shareButton--linkedin-99587\" class=\"shareButton shareButton--linkedin tpt_socialShareIcon tpt_socialSharePopupTrigger\" aria-label=\"Power System EMT Specialist  via LinkedIn delen\" role=\"link\" tabindex=\"0\" target=\"_blank\" href=\"https://careers.tennet.eu/_linkedinApiv2?portalUrl=https%3A%2F%2Fcareers.tennet.eu%2F&amp;action=INIT_SHARE&amp;shareUrl=https%3A%2F%2Fcareers.tennet.eu%2Fnl_NL%2Fcareers%2FJobDetail%3FentityId%3D2917039%26jobId%3D99587\">LinkedIn</a>\n                            </li>\n                                                    <li class=\"list__item cookieconsent-optin-necessary\">\n                                <a id=\"shareButton--twitter-99587\" class=\"shareButton shareButton--twitter tpt_socialShareIcon tpt_socialSharePopupTrigger\" aria-label=\"Power System EMT Specialist  via X delen\" role=\"link\" tabindex=\"0\" target=\"_blank\" href=\"http://twitter.com/intent/tweet?url=https%3A%2F%2Fcareers.tennet.eu%2Fnl_NL%2Fcareers%2FJobDetail%3FentityId%3D2917039%26jobId%3D99587&amp;text=Power+System+EMT+Specialist\">X</a>\n                            </li>\n                                                    <li class=\"list__item cookieconsent-optin-necessary\">\n                                <a id=\"shareButton--email-99587\" class=\"shareButton shareButton--email tpt_socialShareIcon tpt_socialSharePopupTrigger\" aria-label=\"Share Power System EMT Specialist with a friend via e-mail\" role=\"link\" tabindex=\"0\" data-jobname=\"Power System EMT Specialist\" href=\"mailto:?subject=Power%20System%20EMT%20Specialist%20-%20CMP%20-%20External%20Career%20Market%20Place&amp;body=https%3A%2F%2Fcareers.tennet.eu%2Fnl_NL%2Fcareers%2FJobDetail%3FentityId%3D2917039%26jobId%3D99587\">Email</a>\n                            </li>\n                                            </ul>\n                </div>\n            </div>\n        </div>\n                                \n                        </div>\n                    </article>\n                </div>\n            </div>\n        </div>\n    </div>\n\n\n                        \n            <main class=\"main\" id=\"main\">\n                \n                                <div class=\"main__wrapper\">\n                    <div class=\"main__content clearfix\">\n                                                    \n    <div class=\"main-panel\" id=\"main-panel\">\n        <div class=\"grid grid--2--sidebar grid--2--sidebar--aside-right\">\n            <div class=\"banner banner--secondary banner--secondary--top banner--secondary--filter-explanation banner--secondary--job-name visibility--only-mobile\">\n                <div class=\"banner__wrapper\">\n                    <h2 class=\"banner__text__title title title--04\" data-au=\"ag-h2-3\">\n                        Power System EMT Specialist\n                    </h2>\n                </div>\n            </div>\n\n            \n            <div class=\"grid__item grid__item--main\">\n                                        \n\n                \n                                \n\n\n<section class=\"section js_views\">\n    \n            \n    <div class=\"section__content\">\n                \n                        \n                        \n                        \n            \n            \n            \n                            <article class=\"article article--details regular-fields-label--hidden\" >\n                                        \n                    <div class=\"article__content\">\n                        <div class=\"article__content__view\">\n                                                                                                <div class=\"article__content__view__field field--rich-text\">\n                                        \n                                        <div class=\"article__content__view__field__value\">\n                                                                                            <div>Keeping the Netherlands powered, that is our mission. As a Power System EMT Specialist, you help ensure that the electricity grid remains future-proof. Together with your team, you work on complex Electromagnetic Transients and Insulation Coordination challenges that contribute to a stable, secure and sustainable energy system.&nbsp;</div>\n                                                                                    </div>\n                                    </div>\n                                                                                    </div>\n                    </div>\n                </article>\n                    \n                        \n                        \n                        \n            \n            \n            \n                            <article class=\"article article--details \" >\n                                                                    \n    <div class=\"article__header \" >\n        <div class=\"article__header__text\">\n            <h3 class=\"article__header__text__title title title--04\" data-au=\"ag-h3-28\">\n                \n                Your profile and background\n            </h3>\n\n                    </div>\n\n            </div>\n\n                    \n                    <div class=\"article__content\">\n                        <div class=\"article__content__view\">\n                                                                                                <div class=\"article__content__view__field field--rich-text\">\n                                        \n                                        <div class=\"article__content__view__field__value\">\n                                                                                            <div>At TenneT, we are looking for professionals who contribute to an effective and future-proof organisation. We expect you to bring the right experience and expertise to make a valuable contribution to our team and our mission.&nbsp;&nbsp;</div><div><br></div><div>Therefore, we ask that you have:&nbsp;</div><div><ul><li>Master's degree in Electrical Engineering or a comparable technical discipline.&nbsp;</li><li>Minimum of 5 years of experience within the power systems sector.&nbsp;</li><li>Strong expertise in electromagnetic transients (EMT) and insulation coordination in power systems.&nbsp;</li><li>Proven record in performing transient studies and analyzing the impact to the high and extra-high voltage electricity grid&nbsp;</li><li>Experience in conducting, reviewing, and interpreting complex technical studies.&nbsp;</li><li>Solid understanding of power system planning and electricity network behaviour.&nbsp;</li><li>Experience with PSCAD and DIgSILENT PowerFactory.&nbsp;</li><li>Experience with EMTP-ATP or EMTP-RV is considered an advantage.&nbsp;</li><li>Excellent command of the English language, both written and spoken. Dutch language skills are considered an advantage.&nbsp;</li></ul></div><div><br></div><div><strong>Competencies&nbsp;</strong></div><div>To really make a difference in this role, you’ll recognise yourself in the following competencies:&nbsp;</div><div><ul><li>You navigate complex technical challenges, connect insights across disciplines and translate them into clear and actionable recommendations and policy.&nbsp;</li><li>You continuously improve processes, analytical methods and technical standards to enhance quality, efficiency and consistency.&nbsp;</li><li>You understand the organisational and stakeholder landscape, align technical solutions with business objectives and build support across teams.&nbsp;</li></ul></div><div>This role falls within the Specialist job profile, ensuring clarity for both you and TenneT regarding responsibilities, expectations and development opportunities associated with the position.&nbsp;</div>\n                                                                                    </div>\n                                    </div>\n                                                                                    </div>\n                    </div>\n                </article>\n                    \n                        \n                        \n                        \n            \n            \n            \n                            <article class=\"article article--details \" >\n                                                                    \n    <div class=\"article__header \" >\n        <div class=\"article__header__text\">\n            <h3 class=\"article__header__text__title title title--04\" data-au=\"ag-h3-28\">\n                \n                Your contribution to TenneT\n            </h3>\n\n                    </div>\n\n            </div>\n\n                    \n                    <div class=\"article__content\">\n                        <div class=\"article__content__view\">\n                                                                                                <div class=\"article__content__view__field field--rich-text\">\n                                        \n                                        <div class=\"article__content__view__field__value\">\n                                                                                            <div>As a (Senior) Power System EMT Specialist, you are responsible for assessing, evaluating and supervising the electromagnetic transients and insulation coordination of the high voltage and extra-high voltage grid, ensuring that the Dutch electricity system remains reliable, affordable and sustainable.&nbsp;</div><div><br></div><div>Responsibilities&nbsp;</div><div><ul><li>You act as a trusted specialist in the fields of electromagnetic transients (EMT), insulation coordination, providing expert advice to internal stakeholders so that technical decisions can be made for the development of the electricity system.&nbsp;</li><li>You evaluate and supervise EMT and Insulation coordination studies, ensuring that the impact of grid developments, such as new cable connections and changes in network configurations, are properly assessed and managed.&nbsp;</li><li>You analyse system behaviour and define effective mitigation measures so that system integrity and technical performance are safeguarded.&nbsp;</li><li>You review and verify technical studies as part of compliance and assurance processes, ensuring adherence to applicable policies and standards.&nbsp;</li><li>You develop, maintain and improve methodologies, technical frameworks and best practices within the EMT and Insulation Coordination domain, translating regulatory and industry developments into practical solutions and policy for TenneT.&nbsp;</li><li>You collaborate closely with colleagues across TenneT sharing knowledge and coaching less experienced professionals so that expertise is continuously strengthened within the organisation.</li></ul></div>\n                                                                                    </div>\n                                    </div>\n                                                                                    </div>\n                    </div>\n                </article>\n                    \n                        \n                        \n                        \n            \n            \n            \n                            <article class=\"article article--details \" >\n                                                                    \n    <div class=\"article__header \" >\n        <div class=\"article__header__text\">\n            <h3 class=\"article__header__text__title title title--04\" data-au=\"ag-h3-28\">\n                \n                Our recruiting process\n            </h3>\n\n                    </div>\n\n            </div>\n\n                    \n                    <div class=\"article__content\">\n                        <div class=\"article__content__view\">\n                                                                                                <div class=\"article__content__view__field visibility--tablet-and-desktop\">\n                                        \n                                        <div class=\"article__content__view__field__value\">\n                                                                                            <div></div>\n                                                                                    </div>\n                                    </div>\n                                                                                                                                <div class=\"article__content__view__field visibility--tablet-and-desktop\">\n                                        \n                                        <div class=\"article__content__view__field__value\">\n                                                                                            <div></div>\n                                                                                    </div>\n                                    </div>\n                                                                                                                                <div class=\"article__content__view__field visibility--only-mobile\">\n                                        \n                                        <div class=\"article__content__view__field__value\">\n                                                                                            <div></div>\n                                                                                    </div>\n                                    </div>\n                                                                                                                                <div class=\"article__content__view__field visibility--only-mobile\">\n                                        \n                                        <div class=\"article__content__view__field__value\">\n                                                                                            <div></div>\n                                                                                    </div>\n                                    </div>\n                                                                                                                                <div class=\"article__content__view__field visibility--only-mobile\">\n                                        \n                                        <div class=\"article__content__view__field__value\">\n                                                                                            <div></div>\n                                                                                    </div>\n                                    </div>\n                                                                                                                                <div class=\"article__content__view__field visibility--only-mobile\">\n                                        \n                                        <div class=\"article__content__view__field__value\">\n                                                                                            <div></div>\n                                                                                    </div>\n                                    </div>\n                                                                                                                                <div class=\"article__content__view__field visibility--only-mobile\">\n                                        \n                                        <div class=\"article__content__view__field__value\">\n                                                                                            <div></div>\n                                                                                    </div>\n                                    </div>\n                                                                                                                                <div class=\"article__content__view__field visibility--only-mobile\">\n                                        \n                                        <div class=\"article__content__view__field__value\">\n                                                                                            <div></div>\n                                                                                    </div>\n                                    </div>\n                                                                                    </div>\n                    </div>\n                </article>\n                    \n                        \n                        \n                        \n            \n            \n            \n                            <article class=\"article article--details benefits-item\" >\n                                                                    \n    <div class=\"article__header \" >\n        <div class=\"article__header__text\">\n            <h3 class=\"article__header__text__title title title--04\" data-au=\"ag-h3-28\">\n                \n                Our offer\n            </h3>\n\n                    </div>\n\n            </div>\n\n                    \n                    <div class=\"article__content\">\n                        <div class=\"article__content__view\">\n                                                                                                <div class=\"article__content__view__field detail_flexibility\">\n                                        <div class=\"article__content__view__field__value\">\n                                            <div class=\"header-flexibility\"><span class=\"header-flexibility__text\">Flexibility</span><span class=\"header-flexibility__image\"></span></div>\n                                            <div class=\"content\" id=\"benefits-content\" role=\"definition\" >\n                                                <div><strong>We are family friendly and flexible</strong></div> <div>&nbsp;</div> <div>Flexible working hours without fixed times and home office options allow you to organize your work individually. Our external partners also provide you with support services for various phases of life - for example, in matters relating to household services or care and career.</div>\n                                            </div>\n                                            <details>\n                                                <summary>\n                                                    <span class=\"details-action\" aria-details=\"benefits-content\" role=\"term\">Details</span>\n                                                </summary>\n                                            </details>\n                                        </div>\n                                    </div>\n\n                                                                                                                                <div class=\"article__content__view__field detail_payment\">\n                                        <div class=\"article__content__view__field__value\">\n                                            <div class=\"header-payment\"><span class=\"header-payment__text\">Payment &amp; more</span><span class=\"header-payment__image\"></span></div>\n                                            <div class=\"content\" id=\"benefits-content\" role=\"definition\" >\n                                                <div> <div><strong>Attractive remuneration and social benefits</strong></div> <div>&nbsp;</div> <div>We offer great benefits such as a salary based on our Collective Labor Agreement, an annual bonus and excellent pension scheme.</div> </div>\n                                            </div>\n                                            <details>\n                                                <summary>\n                                                    <span class=\"details-action\" aria-details=\"benefits-content\" role=\"term\">Details</span>\n                                                </summary>\n                                            </details>\n                                        </div>\n                                    </div>\n\n                                                                                                                                <div class=\"article__content__view__field detail_wellness\">\n                                        <div class=\"article__content__view__field__value\">\n                                            <div class=\"header-wellness\"><span class=\"header-wellness__text\">Wellness Balance &amp; Personal Growth</span><span class=\"header-wellness__image\"></span></div>\n                                            <div class=\"content\" id=\"benefits-content\" role=\"definition\" >\n                                                <div><strong>Health - your basis</strong></div> <div>&nbsp;</div> <div>Because we think it is important that you are healthy and feel good, we offer all kinds of great extras: we provide various opportunities to work out via our Always Energy program which offers a wide range of opportunities to indulge in sports (organised training for different sports, competitions and events). And you will receive a sports allowance if you are a member of a sports club.</div>\n                                            </div>\n                                            <details>\n                                                <summary>\n                                                    <span class=\"details-action\" aria-details=\"benefits-content\" role=\"term\">Details</span>\n                                                </summary>\n                                            </details>\n                                        </div>\n                                    </div>\n\n                                                                                                                                <div class=\"article__content__view__field detail_technology\">\n                                        <div class=\"article__content__view__field__value\">\n                                            <div class=\"header-technology\"><span class=\"header-technology__text\">Technology &amp; Innovation</span><span class=\"header-technology__image\"></span></div>\n                                            <div class=\"content\" id=\"benefits-content\" role=\"definition\" >\n                                                <div><strong>Modern working environment</strong></div> <div> <ul> <li>Modern IT-tools</li> <li>Ergonomic workstations</li> <li>Very well equipped conference rooms and communication solutions that enable cross-location and cross-border collaboration</li> </ul> </div>\n                                            </div>\n                                            <details>\n                                                <summary>\n                                                    <span class=\"details-action\" aria-details=\"benefits-content\" role=\"term\">Details</span>\n                                                </summary>\n                                            </details>\n                                        </div>\n                                    </div>\n\n                                                                                                                                                                                                                                                                                                                                                                                                </div>\n                    </div>\n                </article>\n                    \n                        \n                        \n                        \n            \n            \n            \n                            <article class=\"article article--details \" >\n                                                                    \n    <div class=\"article__header \" >\n        <div class=\"article__header__text\">\n            <h3 class=\"article__header__text__title title title--04\" data-au=\"ag-h3-28\">\n                \n                This will be our challenge\n            </h3>\n\n                    </div>\n\n            </div>\n\n                    \n                    <div class=\"article__content\">\n                        <div class=\"article__content__view\">\n                                                                                                <div class=\"article__content__view__field \">\n                                        \n                                        <div class=\"article__content__view__field__value\">\n                                                                                            Design translates TenneT’s strategy into a future-proof vision of the energy system. Colleagues within this division have a front-row view of today’s energy system and especially of tomorrow’s. <br />\n<br />\nDesign provides direction for system choices, designs the foundation of the energy system of the future, and creates room for faster implementation. In close alignment with our customers and public stakeholders, Design determines what is needed in the long term to ensure security of supply and system integrity.\n                                                                                    </div>\n                                    </div>\n                                                                                    </div>\n                    </div>\n                </article>\n                    \n                        \n                        \n                        \n            \n            \n            \n                            <article class=\"article article--details \" >\n                                                                    \n    <div class=\"article__header \" >\n        <div class=\"article__header__text\">\n            <h3 class=\"article__header__text__title title title--04\" data-au=\"ag-h3-28\">\n                \n                Additional information\n            </h3>\n\n                    </div>\n\n            </div>\n\n                    \n                    <div class=\"article__content\">\n                        <div class=\"article__content__view\">\n                                                                                                <div class=\"article__content__view__field field--rich-text\">\n                                        \n                                        <div class=\"article__content__view__field__value\">\n                                                                                            <div><div><p class=\"pf0\"><span class=\"cf0\">TenneT</span><span class=\"cf0\"> offers you the opportunity to contribute to a sustainable energy future. Together with colleagues, partners, and stakeholders, you will work on innovative solutions that make the energy transition possible. You will have the space to develop your talent in an environment that puts your growth at the center. We believe in collaboration, forward thinking, and innovation.</span></p><ul><li><span class=\"cf0\">A permanent contract with a two-month probation period, based on 40 hours per week;</span></li><li><span class=\"cf0\">Salary on scale 9; €4.675 - €9.196 per month (based on 40 hours), including annual bonuses and a 70% pension contribution;</span></li><li><span class=\"cf0\">30 vacation days per year.</span></li><li><span class=\"cf0\">Hybrid working, including an internet allowance of </span><span class=\"cf1\">€32.50 and a home-office allowance.</span></li><li><span class=\"cf0\">Support for your vitality, with contributions towards a gym membership and health insurance.</span></li><li><span class=\"cf0\">Development opportunities through the <span class=\"cf0\">TenneT<span class=\"cf0\"> Academy, so you can continue to expand your knowledge and skills.</span></span></span></li></ul><p class=\"pf0\"></p><p class=\"pf0\"><span class=\"cf0\"><br><strong>Apply today and become part of our team!</strong><br>You can apply in just a few clicks through our online form. Once we receive your application, we will review it and contact you as soon as possible.<br>The process consists of two interviews, and a security screening is part of the procedure.<br>Finally, if the vacancy is no longer listed on our website, it means the position has (temporarily) closed. Applications can only be submitted through the website, not by email.</span></p><p class=\"pf0\"></p><p class=\"pf0\"></p><p class=\"pf0\"><span class=\"cf0\"><br>For job-related questions, please contact:<br>Paul Hesen<br>Lead Systems and Markets<br>redacted@example.invalid</span></p><p class=\"pf0\"><span class=\"cf2\"><br><strong><u>Acquisitions/applications related to this vacancy are not welcome.</u></strong></span>&nbsp;</p> </div> </div>\n                                                                                    </div>\n                                    </div>\n                                                                                    </div>\n                    </div>\n                </article>\n                    \n                        \n                        \n                        \n            \n            \n            \n                            <article class=\"article article--details \" >\n                                                                    \n    <div class=\"article__header \" >\n        <div class=\"article__header__text\">\n            <h3 class=\"article__header__text__title title title--04\" data-au=\"ag-h3-28\">\n                \n                Salary\n            </h3>\n\n                    </div>\n\n            </div>\n\n                    \n                    <div class=\"article__content\">\n                        <div class=\"article__content__view\">\n                                                                                                                                                                                                                        <div class=\"article__content__view__field \">\n                                        \n                                        <div class=\"article__content__view__field__value\">\n                                                                                            4816 € - 9472 €\n                                                                                    </div>\n                                    </div>\n                                                                                    </div>\n                    </div>\n                </article>\n                    \n                        \n                        \n                        \n            \n            \n            \n                    \n                        \n                        \n                        \n            \n            \n            \n                            <article class=\"article article--details \" >\n                                                                    \n    <div class=\"article__header \" >\n        <div class=\"article__header__text\">\n            <h3 class=\"article__header__text__title title title--04\" data-au=\"ag-h3-28\">\n                \n                Diversity\n            </h3>\n\n                    </div>\n\n            </div>\n\n                    \n                    <div class=\"article__content\">\n                        <div class=\"article__content__view\">\n                                                                                                <div class=\"article__content__view__field \">\n                                        \n                                        <div class=\"article__content__view__field__value\">\n                                                                                            <div style=\"text-align: justify;\"><span style=\"text-align: start;\">At TenneT, we strive to make our recruitment process as efficient and fair as possible. To support this, we use AI technology as a tool. Our AI solution helps us match applicants based on relevant job titles and skills. It is important to note that no fully automated decisions are ever made; every application is ultimately reviewed by a human recruiter. Our AI does not take personal data such as gender, age, ethnicity, or religion into account, ensuring that applicants are not disadvantaged or discriminated against based on these factors. If you have any questions or objections regarding the use of AI in our recruitment process, please contact us at redacted@example.invalid.<br></span><span style=\"text-align: start;\">_______</span><br style=\"text-align: start;\"><br style=\"text-align: start;\">TenneT keeps the Netherlands powered. We transport electricity 24/7 across the high-voltage grid, connect customers, and enable the energy transition by expanding the grid and using it more intelligently. Together with our partners, we work towards a reliable, affordable and resilient energy system. This is how we connect the Netherlands to a sustainable future.\n<br style=\"text-align: start;\"><br style=\"text-align: start;\"><strong style=\"text-align: start;\">Connecting everyone to a brighter energy future.</strong></div>\n                                                                                    </div>\n                                    </div>\n                                                                                                                                <iframe src='https://www.youtube.com/embed/WbGxKHowIkQ?si=wzk1h0lCXQUxE4wD' width=\"560\" height=\"315\" frameborder=\"0\" title=\"YouTube video player\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen=\"1\" data-cookieconsent=\"preferences\" data-cookieblock-src=\"https://www.youtube.com/embed/WbGxKHowIkQ?si=wzk1h0lCXQUxE4wD\" ></iframe>\n                                                                                    </div>\n                    </div>\n                </article>\n                        </div>\n</section>\n\n                                <ul class=\"list list--links list--links--bottom visibility--tablet-and-desktop\">\n                    <li class=\"list__item\">\n                        <a class=\"link\" href=\"https://careers.tennet.eu/nl_NL/careers/Home\" data-au=\"ag-a-7\">\n                            Terug naar het vacatureoverzicht\n                        </a>\n                    </li>\n                </ul>\n\n            </div>\n\n            <div class=\"grid__item grid__item--aside-right\">\n                <aside class=\"aside\" role=\"presentation\">\n                    \n                    \n                                            <article class=\"article article--view-more--aside\" id=\"widgetRelatedJobs\">\n                \n    </article>\n\n                    \n                    <article class=\"article article__aside--footer\">\n                        <div class=\"article__content-image image--kununu\">\n                            <a href=\"https://www.kununu.com/de/tennet-deutschland?utm_source=prescreen&amp;utm_medium=ats_widget_selfservice_scorelarge&amp;rfr=ats_prescreen\" target=\"_blank\" rel=\"nofollow noopener\">\n                                \n                            </a>\n                        </div>\n\n                        <div class=\"article__content-image image--glassdoor\">\n                            <a href=\"https://www.glassdoor.com/Reviews/TenneT-Reviews-E13092.htm\" target=\"_blank\" rel=\"nofollow noopener\">\n                                \n                            </a>\n                        </div>\n                    </article>\n                </aside>\n\n                <ul class=\"list list--links list--links--bottom visibility--only-mobile\">\n                    <li class=\"list__item\">\n                        <a class=\"link\" href=\"https://careers.tennet.eu/nl_NL/careers/Home\" data-au=\"ag-a-7\">\n                            Terug naar het vacatureoverzicht\n                        </a>\n                    </li>\n                </ul>\n            </div>\n        </div>\n    </div>\n                    </div>\n                </div>\n                            </main>\n\n                        \n                            \n                    </div>\n\n                \n        \n    <portal-data id=\"synapserBootstrap\" data-enabled data-usePermanentConnection=\"true\" data-pageSessionId data-applicationName=\"customPortal\" data-applicationCode=\"customPortal_31\" data-logoutUrl data-publicSessionName=\"CDau9nAvED10BW6VnuIp1u5aCVRu\" data-cortex=\"4\" data-trackerCode=\"FOnIYsNJw2d2W9U7xWAxIkFXIBb1\" data-packVersion=\"1062fce43f88d042de34a163c3dfb1498991d474\"></portal-data><portal-data id=\"replaceEmailShareButtonHref\" data-jobdetailpagename=\"JobDetail\"></portal-data><portal-data id=\"showAlertOnSessionExtend\" data-title=\"Uw sessie verloopt bijna\" data-message=\"In verband met de privacy en veiligheid van uw gegevens, worden sessies automatisch beëindigd na een lange periode van inactiviteit.\" data-mainButton=\"Sessie verlengen\" data-timeout=\"3301000\" data-okButton=\"OK\" data-isSynapserEnabled></portal-data><portal-data id=\"showAlertOnSessionIdleTimeout\" data-title=\"Uw sessie is verlopen\" data-message=\"In verband met de privacy en veiligheid van uw gegevens, worden sessies automatisch beëindigd na een lange periode van inactiviteit.\" data-mainButton=\"Ga terug naar de startpagina\" data-timeout=\"3601000\" data-portalUrl=\"https://careers.tennet.eu/nl_NL/careers\"></portal-data><portal-data id=\"showAlertOnSessionMaxLifetime\" data-title=\"Uw sessie is verlopen\" data-message=\"Om privacy- en veiligheidsredenen is uw gebruikerssessie verlopen omdat deze de maximale duur heeft bereikt.\" data-mainButton=\"Ga terug naar de startpagina\" data-timeout=\"86401000\" data-portalUrl=\"https://careers.tennet.eu/nl_NL/careers\"></portal-data><portal-data id=\"sessionConfigData\" data-checkInterval=\"600000\" data-inter