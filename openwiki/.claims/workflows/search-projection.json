    {
      "id": "claim_48c738d3e01a49d7bb873641b604d10a",
      "statement": "planOutboxBatch loads documents once per aggregate, compares projectionHash against the known hash in search_projection_state to skip unchanged writes, skips superseded mutations whose sequence is at or below the aggregate's applied_sequence, and emits upsert or delete mutations each tagged with target partition and previousPartition for moves.",
