        {
          "resource": "repo://packages/application/src/export/commit-export.ts#L189-L193",
          "version": "repo-lines-v1:sha256:773c1d02f4fbbb763b4c45f4e7cfd10ca27b926d3a7b427cae18cfaac1268c86:"
