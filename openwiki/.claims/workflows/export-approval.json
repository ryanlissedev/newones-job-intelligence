        }
      ]
    },
    {
      "id": "claim_fe4b0e2189844bcdbbf4652729595a4e",
      "statement": "The export idempotency key is the deterministic triple (target, canonicalVacancyId, actionType) rendered as spott:<canonicalVacancyId>:create, stable across snapshots and retries, and identifies the durable export effect reservation independent of the snapshot.",
