    {
      "id": "claim_2dcb8de8051f48ab9fd64af726ef26db",
      "statement": "A failed export never proves the provider did nothing: per-item status is created, failed, or skipped, and a failed/unconfirmed receipt means confirmation was not established, not that the remote create failed; a concurrent caller encountering a reservation with no id records a failed unconfirmed attempt without calling the provider, and neither that attempt nor its receipt authorizes a new create.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/spott-export-reconciliation.md#L16-L20",
