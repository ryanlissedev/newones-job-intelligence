    {
      "id": "claim_35aaf84de12e4760b1d79e7a0bc40618",
      "statement": "Export is the only path to Spott.io and is approval-gated: commit_export calls validateSnapshotApproval before any write, rejecting with NOT_FOUND, APPROVAL_NOT_FOUND, APPROVAL_MISMATCH, or APPROVAL_EXPIRED and stopping before reservation or provider calls when the snapshot/approval/scope/resultIds/expiry checks fail.",
      "evidence": [
        {
          "resource": "repo://packages/application/src/approval/validate-snapshot-approval.ts#L46-L113",
          "version": "repo-lines-v1:sha256:1ee4af840896a537e543b0365a27f5fdfd070a71dffd0c06cc5eecaf68e61642:"
        },
        {
