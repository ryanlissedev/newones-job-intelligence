        }
      ]
    },
    {
      "id": "claim_937f9958cb1c4698bcd66e9a60953468",
      "statement": "drainPostgresOutbox claims rows with FOR UPDATE SKIP LOCKED ordered by sequence_number, stamps a claim_token fencing token and claimed_until lease, uses a NOT EXISTS subquery plus a transaction-scoped advisory lock to keep one aggregate inside one drain at a time, and acks or blames per row; rows reaching maxAttempts (default 5) are dead-lettered and excluded from claims until requeued.",
      "evidence": [
        {
          "resource": "repo://packages/db/src/outbox-drain.ts#L136-L230",
          "version": "repo-lines-v1:sha256:ffbfa5e3d250af2eff60ac17bb18fe9d7c198e72f4fc849dc7e6581c3a3c3205:"
