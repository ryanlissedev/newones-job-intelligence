        }
      ]
    },
    {
      "id": "claim_e3e2d007fe744d82956dac01cb42c45e",
      "statement": "The outbox projection watermark is search_projection_state (one row per aggregate: applied_sequence, generation, projection_hash); the drain skips the Manticore write when the hash is unchanged within the same generation, so curated edits that do not touch indexed fields never reindex.",
      "evidence": [
        {
          "resource": "repo://packages/db/src/schema/curated.ts#L603-L622",
          "version": "repo-lines-v1:sha256:271294eb7a88dd3e4ba1f3f856c774d1fef860e3ce9def49c94f7b65a905cba4:"
        }
