          "version": "repo-lines-v1:sha256:e53d0528e9299553e90889270a3032a03f06eca7bdcd8369a9836767ae28b306:"
        }
      ]
    },
    {
      "id": "claim_7ddd3358ba02482092db199ce9bbe302",
      "statement": "curated.outbox_event is the durable event log bridging curated state and the Manticore search index; it carries a monotonic GENERATED ALWAYS AS IDENTITY sequence_number (bigint since 0006), per-row claim_token/claimed_until lease, retry_count, last_error, dead_lettered_at, and processed_at ack.",
      "evidence": [
        {
          "resource": "repo://packages/db/src/migrations/0006_search_projection_checkpoint.sql#L1-L16",
          "version": "repo-lines-v1:sha256:678fe9ab15af1fee03af1d6d707c8d30b4884149f6dbc35f31f6f8c342610159:"
