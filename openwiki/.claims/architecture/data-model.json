    {
      "id": "claim_00e6024ea60041bd9df7f125ce332aeb",
      "statement": "Vacancy history uses SCD2: writeAanvraagVersion in packages/db/src/scd2.ts atomically closes the open aanvraag_versie row, inserts the new version with snapshot/content_hash/raw_payload_ref, inserts an outbox_event for the aggregate, and updates the aanvraag's versie pointer, all in one transaction so the search index never sees an event for an uncommitted version.",
      "evidence": [
        {
          "resource": "repo://packages/db/src/scd2.ts#L24-L89",
          "version": "repo-lines-v1:sha256:668707e74d11a129ead7ed7e994bb624011df4b5f8c38b24f4ceb0cd8b3af49a:"
        },
