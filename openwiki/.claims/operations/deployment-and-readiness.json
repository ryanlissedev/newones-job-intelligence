    {
      "id": "claim_0884c2dd8ca543fa8d5193db8fe940d4",
      "statement": "Long-running singleton processes (projector, poller) hold a Postgres session-level advisory lock; a pooled endpoint (PgBouncer / Neon pooler) can move consecutive queries between backend sessions and break the singleton guarantee, so PROJECTOR_DATABASE_URL and POLLER_DATABASE_URL must use a direct endpoint. packages/env/src/projector-database-url.ts validates this at startup by rejecting *-pooler.*.neon.tech and *.pooler.*.neon.tech hostnames and requiring a postgres/postgresql protocol. Ordinary data queries may still use a pooled DATABASE_URL.",
      "evidence": [
        {
          "resource": "repo://packages/env/src/poller.ts#L121-L121",
          "version": "repo-lines-v1:sha256:4bdc8860c47fe8075df9e70452f4e96605b9f5404a768792238c09d1f03157b5:"
