    {
      "id": "claim_c1da72713ce14812875c093ad8d0c57e",
      "statement": "Each registry invocation validates the trusted context, checks the capability exists, authorises the principal against authorization.permission, checks the transport is bound, parses the input schema, runs the handler, and validates the output envelope (ok/error) plus the output or failure schema; mismatches become INVALID_INPUT, INTERNAL_ERROR, or HANDLER_CONTRACT_VIOLATION.",
      "evidence": [
        {
          "resource": "repo://packages/application/src/registry/registry.ts#L289-L323",
