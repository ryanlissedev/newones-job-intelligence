      "statement": "The BooleanNode AST has five node types: BooleanTerm ({kind:'term', value}), BooleanPhrase ({kind:'phrase', value}), BooleanNot ({kind:'not', operand}), BooleanAnd ({kind:'and', operands[]}), BooleanOr ({kind:'or', operands[]}). parseBooleanQuery returns a discriminated union: {ok:true, ast, version} on success or {ok:false, error} on failure.",
