# Docker Compose defaults for the isolated local P0 database.
# Production values belong in the deployment secret manager, not in git.

POSTGRES_ADMIN_USER=ji_admin
POSTGRES_ADMIN_PASSWORD=ji_admin_local
POSTGRES_DB=ji_test
POSTGRES_MIGRATOR_USER=ji_migrator
POSTGRES_MIGRATOR_PASSWORD=ji_migrator_local
POSTGRES_APP_USER=ji_app
POSTGRES_APP_PASSWORD=ji_app_local
POSTGRES_HOST_PORT=5432
POSTGRES_DATA_VOLUME=catapulze-postgres-p0

# The server container connects over the private Compose network.
CATAPULZE_DATABASE_URL=postgresql://ji_app:ji_app_local@postgres:5432/ji_test
# The projector advisory lock uses a dedicated direct connection. Locally it
# targets the same non-pooled Postgres service; production must use Neon's
# direct (non-pooler) endpoint for the same branch/database and app role.
PROJECTOR_DATABASE_URL=postgresql://ji_app:ji_app_local@postgres:5432/ji_test
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Server-only API URL for the Next.js server process (dashboard SSR session
# lookup). docker-compose.yml pins it to http://server:3000 for the web
# service; leave unset for plain local dev to fall back to NEXT_PUBLIC_SERVER_URL.
# INTERNAL_SERVER_URL=http://server:3000
# Public release identity; deployment replaces this non-secret placeholder.
APP_RELEASE_SHA=0000000000000000000000000000000000000000

# Search stack (U6): Manticore RT + Redis result cache
MANTICORE_URL=http://127.0.0.1:9308
MANTICORE_HTTP_PORT=9308
MANTICORE_MYSQL_PORT=9306
# Manticore 29 hybrid search candidate. Default remains lexical/off.
SEARCH_HYBRID=0
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST_PORT=6379

# Optional read-only Motian-Neon import source for U8 backfill (never commit real values)
# MOTIAN_DATABASE_URL=postgresql://readonly_role:replace_me@host/dbname

# Local defaults are intentionally modest. The production runbook starts with
# a larger Postgres budget and keeps Manticore rebuildable and lower priority.
POSTGRES_CPU_LIMIT=2.0
POSTGRES_MEMORY_LIMIT=4g
POSTGRES_MEMORY_RESERVATION=1g
POSTGRES_SHM_SIZE=512m

# WAL archive fixture for CI/local restore drills (docker-compose.backup.yml).
# Production uses a separate off-site bucket and credentials from the secret manager.
WALG_S3_ACCESS_KEY=walg_local
WALG_S3_SECRET_KEY=walg_local_secret
WALG_S3_BUCKET=catapulze-pg-backup
WALG_S3_REGION=us-east-1
WALG_RETENTION_POLICY=7d
MINIO_API_PORT=9000
